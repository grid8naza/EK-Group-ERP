# What Prettier must not touch.
#
# node_modules is skipped by default; everything here is something Prettier
# WOULD happily rewrite and should not.

# Build output — regenerated, never read, and huge.
backend/dist/
frontend/.next/
frontend/out/
coverage/

# Machine-written. Reformatting a lockfile invents a merge conflict out of
# nothing and can make an install non-reproducible.
package-lock.json
backend/package-lock.json
frontend/package-lock.json

# Generated by `prisma generate` / stored uploads — not source.
backend/node_modules/.prisma/
backend/uploads/

# Database dumps and their sidecar metadata. Data, not code: the .meta.json
# describes a specific .dump file and is written by the backup routine.
backend/backups/

# Seed tables — data that happens to be written in TypeScript. One record per
# line, aligned, read and diffed like a spreadsheet; that IS the format, and it
# is why a 253-account chart of accounts is reviewable at all. Prettier at 80
# columns turns each record into ten lines and the file from 600 into 6,900.
# Logic that merely lives beside them (master-data-seed.service.ts) is NOT
# exempt — only the tables themselves.
backend/src/master-data/*.data.ts
backend/src/modules/accounts/coa-data.ts
backend/src/modules/accounts/coa-revisions.ts
