# ---- Database ----
POSTGRES_USER=erpgrip
POSTGRES_PASSWORD=erpgrip
POSTGRES_DB=erpgrip
POSTGRES_PORT=5432

# Connection string used by Prisma / NestJS.
# Host "db" is the docker-compose service name; use "localhost" for local dev.
DATABASE_URL=postgresql://erpgrip:erpgrip@db:5432/erpgrip?schema=public

# ---- Backend ----
BACKEND_PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# Seed credentials for the initial super admin
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=Super Administrator
SEED_ADMIN_EMAIL=admin@erpgrip.local

# High security password — a second gate (separate from any login password)
# required before a database backup or restore. Seeded once; change it in-app
# via Cpanel → Backup & Restore.
SEED_HIGH_SECURITY_PASSWORD=Backup@123
# Where backup .dump files are stored on the backend (a Docker volume in compose).
BACKUP_DIR=/app/backups

# ---- Frontend ----
FRONTEND_PORT=3000
# URL the browser uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:4000/api
