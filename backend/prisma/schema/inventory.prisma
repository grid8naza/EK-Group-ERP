// Inventory domain — stock & inventory master data.
//
// This is the Inventory module's own domain file. Per the ownership rule in
// schema.prisma, any cross-domain reference (e.g. companyId -> Cpanel Company)
// is a PLAIN id column with NO @relation. Unit Master is GLOBAL (company-
// independent), like Currency, so it carries no companyId at all.

enum UnitType {
  SIMPLE
  COMPOUND
}

/// Unit of Measure master (global). A SIMPLE unit stands alone (e.g. Piece,
/// Kilogram). A COMPOUND unit is defined as `conversionFactor` × a simple base
/// unit (e.g. 1 Box = 12 Pieces), so quantities in a compound unit can be
/// converted to its base for stock keeping. The base→derived link is a
/// self-relation, which is allowed because both rows live in this same domain.
model Unit {
  id               Int      @id @default(autoincrement())
  code             String   @unique // global ⇒ globally unique
  name             String
  symbol           String?
  type             UnitType @default(SIMPLE)
  // COMPOUND only: the simple base unit and how many base units one of THIS
  // unit equals (1 this = conversionFactor × base). Both null for SIMPLE.
  baseUnitId       Int?
  conversionFactor Float?
  // Decimal places allowed when entering a quantity in this unit.
  decimalPlaces    Int      @default(0)
  isActive         Boolean  @default(true)
  isLocked         Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  baseUnit Unit?  @relation("UnitBase", fields: [baseUnitId], references: [id])
  derived  Unit[] @relation("UnitBase")

  itemsAsUnit    Item[] @relation("ItemUnit")
  itemsAsBoxUnit Item[] @relation("ItemBoxUnit")

  @@map("units")
}

/// Category master shared by Items and Products. Availability is multi-company:
/// `allCompanies = true` makes it available to every company (including ones
/// added later); otherwise it is available only to the companies linked via
/// CategoryCompany. `forItem` / `forProduct` flag which masters it applies to
/// (at least one).
model Category {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  description  String?
  allCompanies Boolean  @default(false) // true = available to every company
  forItem      Boolean  @default(true)
  forProduct   Boolean  @default(false)
  isActive     Boolean  @default(true)
  isLocked     Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companies CategoryCompany[]
  groups    Group[]
  items     Item[]

  @@map("categories")
}

/// Links a category to a company it is available in (used when the category is
/// not `allCompanies`). companyId is a plain id → Cpanel Company (no @relation;
/// cross-domain rule); categoryId is in-domain so it keeps a real relation.
model CategoryCompany {
  id         Int @id @default(autoincrement())
  categoryId Int
  companyId  Int // -> Cpanel Company, by id (no cross-domain FK)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, companyId])
  @@index([companyId])
  @@map("category_companies")
}

/// Group master — a sub-level under a Category (Category → Group). Mirrors
/// Category: applies to Items and/or Products, and is available to all
/// companies or a chosen set (GroupCompany). Deleting a category is blocked
/// while it still has groups (Restrict).
model Group {
  id           Int      @id @default(autoincrement())
  categoryId   Int
  code         String   @unique
  name         String
  description  String?
  allCompanies Boolean  @default(false) // true = available to every company
  forItem      Boolean  @default(true)
  forProduct   Boolean  @default(false)
  isActive     Boolean  @default(true)
  isLocked     Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category  Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  companies GroupCompany[]
  items     Item[]

  @@index([categoryId])
  @@map("groups")
}

/// Links a group to a company it is available in (when not `allCompanies`).
model GroupCompany {
  id        Int @id @default(autoincrement())
  groupId   Int
  companyId Int // -> Cpanel Company, by id (no cross-domain FK)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, companyId])
  @@index([companyId])
  @@map("group_companies")
}

/// HSN code master (global). HSN classifies goods for GST; the CGST/SGST/IGST
/// rates are statutory and identical across companies, so this is not company-
/// scoped. Intra-state tax = CGST + SGST; inter-state = IGST (usually their sum).
model HsnCode {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  description String
  cgst        Float    @default(0) // %
  sgst        Float    @default(0) // %
  igst        Float    @default(0) // %
  isActive    Boolean  @default(true)
  isLocked    Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items Item[]

  @@map("hsn_codes")
}

/// Item master. Classified (optionally) under a Category/Group, stocked in a
/// Unit, optionally packed in boxes (boxQty of boxUnit), taxed by an HSN code,
/// with stock-control levels. Availability is multi-company (all companies or a
/// chosen set, via ItemCompany). All masters referenced live in this domain, so
/// they use real relations; only company links are plain cross-domain ids.
model Item {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  description  String?
  categoryId   Int?
  groupId      Int?
  unitId       Int // stock unit
  unitPrice    Float    @default(0)
  boxQty       Float    @default(0) // how many stock units per box
  boxUnitId    Int? // unit that represents a box (e.g. BOX, CARTON)
  hsnCodeId    Int?
  minimumStock Float    @default(0)
  maximumStock Float    @default(0)
  reorderLevel Float    @default(0)
  leadTime     Int      @default(0) // days
  allCompanies Boolean  @default(false) // true = available to every company
  isActive     Boolean  @default(true)
  isLocked     Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category  Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  group     Group?        @relation(fields: [groupId], references: [id], onDelete: Restrict)
  unit      Unit          @relation("ItemUnit", fields: [unitId], references: [id], onDelete: Restrict)
  boxUnit   Unit?         @relation("ItemBoxUnit", fields: [boxUnitId], references: [id], onDelete: Restrict)
  hsnCode   HsnCode?      @relation(fields: [hsnCodeId], references: [id], onDelete: Restrict)
  companies ItemCompany[]

  @@index([categoryId])
  @@index([groupId])
  @@index([unitId])
  @@map("items")
}

/// Links an item to a company it is available in (when not `allCompanies`).
model ItemCompany {
  id        Int @id @default(autoincrement())
  itemId    Int
  companyId Int // -> Cpanel Company, by id (no cross-domain FK)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, companyId])
  @@index([companyId])
  @@map("item_companies")
}
