// Inventory domain — stock & inventory master data.
//
// This is the Inventory module's own domain file. Per the ownership rule in
// schema.prisma, any cross-domain reference (e.g. companyId -> Cpanel Company)
// is a PLAIN id column with NO @relation. Unit Master is GLOBAL (company-
// independent), like Currency, so it carries no companyId at all.

enum UnitType {
  SIMPLE
  COMPOUND
  CHAINING
}

/// Which bill-of-materials a Product BOM line belongs to.
enum BomKind {
  RECIPE
  PACKING
}

/// What a Category classifies. This is the TOP of the classification tree and
/// the only place the four kinds of stock are named, so every screen that owns
/// one kind (Items, Packing Material, Products - Unpacked, Products - Packed)
/// filters on the kind rather than on a category's name — renaming a category
/// never strands a screen.
///
/// Exactly one kind per category, because the four are disjoint by nature: a
/// stocked thing is bought (ingredient or packing material) or made
/// (semi-finished or finished), never both. That is what lets a Product name a
/// single category and have its screen follow from it.
enum CategoryKind {
  INGREDIENT
  PACKING_MATERIAL
  SEMI_FINISHED
  FINISHED
}

/// Where a product comes from: made in-house, or bought in to resell.
///
/// This is DECLARED, not inferred. "Has no recipe" cannot stand in for it — a
/// manufactured product whose recipe has not been entered yet looks exactly the
/// same — so a traded good has to say so. It is what separates in-house
/// production from resale stock on the production screens, the purchase
/// screens and the reports.
enum ProductSource {
  MANUFACTURED // made in-house; may carry a recipe / packing BOM
  PURCHASED // resale / traded goods; bought ready-made, never has a BOM
}

/// Unit of Measure master (global). A SIMPLE unit stands alone (e.g. Piece,
/// Kilogram). A COMPOUND unit is defined as `conversionFactor` × a simple base
/// unit (e.g. 1 Box = 12 Pieces), so quantities in a compound unit can be
/// converted to its base for stock keeping. A CHAINING unit is a nested
/// packaging ladder (e.g. 1 Carton = 10 Box, 1 Box = 100 Gram) whose rungs live
/// in `chainLinks`; its `baseUnitId`/`conversionFactor` are RESOLVED from that
/// ladder (base = the bottom simple unit, factor = product of all rung
/// quantities), so it converts to stock exactly like a compound. The
/// base→derived link is a self-relation, which is allowed because both rows
/// live in this same domain.
model Unit {
  id               Int      @id @default(autoincrement())
  code             String   @unique // global ⇒ globally unique
  name             String
  symbol           String?
  type             UnitType @default(SIMPLE)
  // COMPOUND: the simple base unit and how many base units one of THIS unit
  // equals (1 this = conversionFactor × base). CHAINING: same fields, but
  // RESOLVED from the chainLinks ladder. Both null for SIMPLE.
  baseUnitId       Int?
  conversionFactor Float?
  // Decimal places allowed when entering a quantity in this unit.
  decimalPlaces    Int      @default(0)
  isActive         Boolean  @default(true)
  isLocked         Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  baseUnit Unit?  @relation("UnitBase", fields: [baseUnitId], references: [id])
  derived  Unit[] @relation("UnitBase")

  chainLinks  UnitChainLink[] @relation("UnitChainOwner") // ladder owned by this CHAINING unit
  chainUsages UnitChainLink[] @relation("UnitChainStep")  // rungs elsewhere that reference this unit

  itemsAsUnit    Item[] @relation("ItemUnit")
  itemsAsBoxUnit Item[] @relation("ItemBoxUnit")

  productsAsUnit      Product[]        @relation("ProductUnit")
  productsAsBoxUnit   Product[]        @relation("ProductBoxUnit")
  productsAsYieldUnit Product[]        @relation("ProductYieldUnit")
  bomLineUnits        ProductBomLine[] @relation("BomLineUnit")

  @@map("units")
}

/// One rung of a CHAINING unit's ladder: `1 (level above) = quantity × linkUnit`.
/// Rows are ordered by `sequence` (0 = top, just under the owning unit). The
/// last rung's linkUnit is SIMPLE and equals the owning unit's resolved
/// baseUnit; the product of all rung quantities equals its resolved
/// conversionFactor.
model UnitChainLink {
  id         Int   @id @default(autoincrement())
  unitId     Int // the CHAINING unit that owns this ladder
  sequence   Int // 0-based, top → bottom
  linkUnitId Int // existing unit this rung references (Box, GM…)
  quantity   Float

  unit     Unit @relation("UnitChainOwner", fields: [unitId], references: [id], onDelete: Cascade)
  linkUnit Unit @relation("UnitChainStep", fields: [linkUnitId], references: [id], onDelete: Restrict)

  @@unique([unitId, sequence])
  @@index([linkUnitId])
  @@map("unit_chain_links")
}

/// Category master — the top level of the classification tree, and the one
/// place the four kinds of stock are declared (see CategoryKind). Availability
/// is multi-company: `allCompanies = true` makes it available to every company
/// (including ones added later); otherwise it is available only to the
/// companies linked via CategoryCompany.
///
/// A category does NOT own a group subtree. Groups are shared across
/// categories through GroupCategory, so "Bakery" is defined once and serves
/// both the semi-finished and the finished categories instead of being typed
/// out under each.
model Category {
  id           Int          @id @default(autoincrement())
  code         String       @unique
  name         String
  description  String?
  allCompanies Boolean      @default(false) // true = available to every company
  kind         CategoryKind // what this category classifies — exactly one
  isActive     Boolean      @default(true)
  isLocked     Boolean      @default(false) // when locked, must be unlocked before edit/delete
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  companies CategoryCompany[]
  groups    GroupCategory[]
  items     Item[]
  products  Product[] @relation("CategoryProducts")

  @@index([kind])
  @@map("categories")
}

/// Links a category to a company it is available in (used when the category is
/// not `allCompanies`). companyId is a plain id → Cpanel Company (no @relation;
/// cross-domain rule); categoryId is in-domain so it keeps a real relation.
model CategoryCompany {
  id         Int @id @default(autoincrement())
  categoryId Int
  companyId  Int // -> Cpanel Company, by id (no cross-domain FK)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, companyId])
  @@index([companyId])
  @@map("category_companies")
}

/// Group master — one shared classification tree that CATEGORIES DRAW FROM,
/// rather than a subtree owned by a single category. A group declares which
/// categories it serves via GroupCategory, so "Bakery" is one row available to
/// both the semi-finished and the finished category; without that the same
/// sub-groups had to be re-entered under every category that needed them.
///
/// Because a group can serve several categories it has no category segment in
/// its code (see hierarchy-code.ts): the CC digits stay 00 on a group and are
/// filled in at the Item/Product level, where exactly one category IS chosen.
/// Level-1 numbering is therefore global, not per category.
///
/// What a group applies to is no longer stored — it follows from the kinds of
/// the categories it serves (INGREDIENT/PACKING_MATERIAL ⇒ items,
/// SEMI_FINISHED/FINISHED ⇒ products), which is also what binds a subtree to a
/// screen now that ProductStage is gone.
model Group {
  id Int @id @default(autoincrement())
  // Self-referencing hierarchy: a "primary" group has no parent (level 1); a
  // sub-group's parent is another group whose `subGroupApplicable` is true, and
  // its categories must be a SUBSET of that parent's (enforced in the service).
  // `level` is parent.level + 1, capped at 5.
  parentGroupId      Int?
  level              Int     @default(1) // 1 = primary group … up to 5
  subGroupApplicable Boolean @default(false) // true = container: holds sub-groups, NOT items
  code         String   @unique // system-generated 17-digit hierarchy code (CC = 00)
  name         String
  description  String?
  allCompanies Boolean  @default(false) // true = available to every company
  isActive     Boolean  @default(true)
  isLocked     Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parent     Group?          @relation("GroupHierarchy", fields: [parentGroupId], references: [id], onDelete: Restrict)
  children   Group[]         @relation("GroupHierarchy")
  categories GroupCategory[]
  companies  GroupCompany[]
  items      Item[]
  products   Product[]       @relation("GroupProducts")

  @@index([parentGroupId])
  @@map("groups")
}

/// Links a group to a category it is available under. This is what lets one
/// group serve several categories. Deleting a category is blocked while groups
/// still point at it (Restrict), matching the old categoryId behaviour.
model GroupCategory {
  id         Int @id @default(autoincrement())
  groupId    Int
  categoryId Int

  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([groupId, categoryId])
  @@index([categoryId])
  @@map("group_categories")
}

/// Links a group to a company it is available in (when not `allCompanies`).
model GroupCompany {
  id        Int @id @default(autoincrement())
  groupId   Int
  companyId Int // -> Cpanel Company, by id (no cross-domain FK)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, companyId])
  @@index([companyId])
  @@map("group_companies")
}

/// HSN code master (global). HSN classifies goods for GST; the CGST/SGST/IGST
/// rates are statutory and identical across companies, so this is not company-
/// scoped. Intra-state tax = CGST + SGST; inter-state = IGST (usually their sum).
model HsnCode {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  description String
  cgst        Float    @default(0) // %
  sgst        Float    @default(0) // %
  igst        Float    @default(0) // %
  cess        Float    @default(0) // %
  isActive    Boolean  @default(true)
  isLocked    Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items    Item[]
  products Product[] @relation("HsnProducts")

  @@map("hsn_codes")
}

/// Item master. Classified under a Category + leaf Group, stocked in a Unit,
/// optionally packed in boxes (boxQty of boxUnit), taxed by an HSN code, with
/// stock-control levels. Availability is multi-company (all companies or a
/// chosen set, via ItemCompany). All masters referenced live in this domain, so
/// they use real relations; only company links are plain cross-domain ids.
///
/// Both category and group are REQUIRED and together build the code: the
/// category supplies its CC digits, the group the level digits. The chosen
/// category must be one the group serves, and its kind must be INGREDIENT or
/// PACKING_MATERIAL — a product kind belongs on Product.
model Item {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  description  String?
  categoryId   Int
  groupId      Int
  unitId       Int // stock unit
  lastPurchasePrice Float     @default(0) // updated on every purchase
  lastPurchaseDate  DateTime? // updated on every purchase (null = never purchased)
  boxQty       Float    @default(0) // how many stock units per box
  boxUnitId    Int? // unit that represents a box (e.g. BOX, CARTON)
  hsnCodeId    Int?
  minimumStock Float    @default(0)
  maximumStock Float    @default(0)
  reorderLevel Float    @default(0)
  leadTime     Int      @default(0) // days
  shelfLife    Int      @default(0) // days (0 = not tracked / non-perishable)
  allCompanies Boolean  @default(false) // true = available to every company
  isActive     Boolean  @default(true)
  isLocked     Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category  Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  group     Group         @relation(fields: [groupId], references: [id], onDelete: Restrict)
  unit      Unit          @relation("ItemUnit", fields: [unitId], references: [id], onDelete: Restrict)
  boxUnit   Unit?         @relation("ItemBoxUnit", fields: [boxUnitId], references: [id], onDelete: Restrict)
  hsnCode   HsnCode?      @relation(fields: [hsnCodeId], references: [id], onDelete: Restrict)
  companies ItemCompany[]

  bomUsages ProductBomLine[] @relation("ItemBomUsage") // BOM lines that consume this item

  @@index([categoryId])
  @@index([groupId])
  @@index([unitId])
  @@map("items")
}

/// Links an item to a company it is available in (when not `allCompanies`).
model ItemCompany {
  id        Int @id @default(autoincrement())
  itemId    Int
  companyId Int // -> Cpanel Company, by id (no cross-domain FK)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, companyId])
  @@index([companyId])
  @@map("item_companies")
}

/// Finished-product master. Like an Item but a sellable output assembled from
/// items via two bills of materials: a RECIPE BOM (ingredients) and a PACKING
/// BOM (packing materials), both in `bomLines`. `yieldQty` is how many product
/// units one recipe batch produces. Lives in the inventory domain so its
/// Category/Group/Unit/Hsn/Item links are real relations; companyId stays a
/// plain cross-domain id (via ProductCompany). The BOM is edited under
/// Production; the rest of the master under Inventory.
///
/// Both category and group are REQUIRED and together build the code. The
/// category is CHOSEN, not inherited from the group — that choice is what
/// separates a semi-finished from a finished product sharing the same group,
/// and it is what each product screen filters on. It must be one of the
/// group's categories and its kind must be SEMI_FINISHED or FINISHED.
model Product {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  description  String?
  imageUrl     String? // product picture (sellable products), served at /uploads/products
  categoryId   Int
  groupId      Int
  unitId       Int // selling / output unit
  // Form factor: a product may be sold unpacked, packed, or both.
  unpacked     Boolean @default(false)
  packed       Boolean @default(false)
  canSell      Boolean @default(true) // false = not sold (e.g. intermediate/ingredient)
  costPrice    Float   @default(0) // cost incurred to make/buy one unit
  // Three selling prices, each with its profit % over cost (both stored; the
  // form keeps them in sync — edit a price to set its %, or a % to set the price).
  wholesalePrice        Float @default(0)
  wholesaleProfitPct    Float @default(0)
  intercompanyPrice     Float @default(0)
  intercompanyProfitPct Float @default(0)
  retailPrice           Float @default(0)
  retailProfitPct       Float @default(0)
  boxQty       Float    @default(0) // pack content quantity (in boxUnit)
  boxUnitId    Int? // unit the box/pack quantity is measured in (e.g. g, Kg)
  hsnCodeId    Int?
  shelfLife    Int      @default(0) // days
  yieldQty     Float    @default(1) // product units one recipe batch yields
  yieldUnitId  Int? // unit the yield quantity is measured in
  // BOM costing inputs. Material cost is computed from the recipe lines; these
  // are the other cost buckets and the margin used to derive the sales price.
  labourCost   Float    @default(0)
  fuelCost     Float    @default(0)
  overheadCost Float    @default(0)
  bomMarginPct Float    @default(0) // profit margin % applied to the total cost
  // Per-yield-unit "actual" prices set from the recipe editor. Actual cost price
  // is populated from the estimated cost/unit (used later in Packing); actual
  // sales price is entered by the user (used later for the sales invoice).
  actualCostPrice  Float @default(0)
  actualSalesPrice Float @default(0)
  /// Made in-house or bought in for resale. A PURCHASED product may not carry
  /// either BOM (the service rejects hasRecipe/hasPacking on it, and refuses to
  /// flip a product to PURCHASED while a BOM, process or pack source exists);
  /// it may still be `isIngredient`, since a bought-in filling can go into
  /// someone else's recipe.
  source       ProductSource @default(MANUFACTURED)
  // Capability flags: which BOMs may be created for this product, and whether
  // it can itself be an ingredient in another product's recipe.
  hasRecipe    Boolean  @default(false) // a production (recipe) BOM can be created
  hasPacking   Boolean  @default(false) // a packing BOM can be created
  isIngredient Boolean  @default(false) // usable as an ingredient in another product
  // Production schedule — the days this product is made on. Flat flags, not a
  // list: the days of the week are fixed by nature and never need configuring,
  // and it matches how every other checkbox set on this model is stored. Delivery
  // trips are the opposite case — the user names those — so they live in a lookup
  // (see ProductDeliveryTrip).
  prodSun        Boolean @default(false)
  prodMon        Boolean @default(false)
  prodTue        Boolean @default(false)
  prodWed        Boolean @default(false)
  prodThu        Boolean @default(false)
  prodFri        Boolean @default(false)
  prodSat        Boolean @default(false)
  /// Made to order — no fixed day, so it stands apart from the weekdays.
  prodOccasional Boolean @default(false)
  // No `allCompanies` here, unlike the other masters: every company this
  // product touches needs its own roles and costing (see ProductCompany), so
  // there is nothing a blanket flag could hang those on. A product is available
  // exactly where it has a company row.
  isActive     Boolean  @default(true)
  isLocked     Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category Category  @relation("CategoryProducts", fields: [categoryId], references: [id], onDelete: Restrict)
  group    Group     @relation("GroupProducts", fields: [groupId], references: [id], onDelete: Restrict)
  unit      Unit      @relation("ProductUnit", fields: [unitId], references: [id], onDelete: Restrict)
  boxUnit   Unit?     @relation("ProductBoxUnit", fields: [boxUnitId], references: [id], onDelete: Restrict)
  yieldUnit Unit?     @relation("ProductYieldUnit", fields: [yieldUnitId], references: [id], onDelete: Restrict)
  hsnCode  HsnCode?  @relation("HsnProducts", fields: [hsnCodeId], references: [id], onDelete: Restrict)

  companies ProductCompany[]
  deliveryTrips ProductDeliveryTrip[]
  discounts ProductDiscount[]
  bomLines  ProductBomLine[]
  processes ProductProcess[]
  packSources  ProductPackSource[] @relation("PackSources")  // unpacked products this pack is made from
  packSourceOf ProductPackSource[] @relation("PackSourceOf") // packs that use this product as a source
  branchStocks ProductBranchStock[] // per-branch stocking parameters

  @@index([categoryId])
  @@index([groupId])
  @@index([source])
  @@map("products")
}

/// One source line of a PACKED product's packing: `quantity` of an unpacked
/// `sourceProduct` that goes into one packing batch. The per-unit cost used for
/// the packing "Product Cost" is read from the source product's `costPrice`.
model ProductPackSource {
  id              Int   @id @default(autoincrement())
  productId       Int // the packed product
  sourceProductId Int // an unpacked product it is packed from
  sequence        Int   @default(0)
  quantity        Float

  product       Product @relation("PackSources", fields: [productId], references: [id], onDelete: Cascade)
  sourceProduct Product @relation("PackSourceOf", fields: [sourceProductId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([sourceProductId])
  @@map("product_pack_sources")
}

/// Time unit for a production process step.
enum ProcessTimeUnit {
  MIN
  HR
}

/// One step of a Product's production process flow: an ordered stage with the
/// time it takes and the machine it runs on. `machineId` points at the Asset
/// (production-line machine) master by plain id — cross-domain, so no @relation
/// (mirrors AssetBooking.productId). Ordered by `sequence`.
model ProductProcess {
  id          Int             @id @default(autoincrement())
  productId   Int
  sequence    Int             @default(0)
  name        String // process / step name
  description String?
  timeValue   Float           @default(0)
  timeUnit    ProcessTimeUnit @default(MIN)
  machineId   Int? // -> Asset (production-line machine), plain id (no cross-domain FK)

  product  Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  manpower ProductProcessManpower[]

  @@index([productId])
  @@map("product_processes")
}

/// Manpower assigned to a production process step: `workerCount` workers of a
/// given HR designation. `designationId` points at the HR Designation master by
/// plain id — cross-domain, so no @relation (mirrors ProductProcess.machineId).
/// The rate/hour is read from that designation at costing time; only the
/// designation + count are stored here. Cost = rate × step-hours × workerCount.
model ProductProcessManpower {
  id            Int @id @default(autoincrement())
  processId     Int
  designationId Int // -> HR Designation (plain id, no cross-domain FK)
  workerCount   Int @default(1)

  process ProductProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@map("product_process_manpower")
}

/// One line of a Product's RECIPE or PACKING bill of materials: `quantity` of
/// `item` (measured in `unit`). Ordered by `sequence` within each kind.
model ProductBomLine {
  id        Int     @id @default(autoincrement())
  productId Int
  kind      BomKind
  sequence  Int     @default(0)
  itemId    Int
  quantity  Float
  unitId    Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  item    Item    @relation("ItemBomUsage", fields: [itemId], references: [id], onDelete: Restrict)
  unit    Unit    @relation("BomLineUnit", fields: [unitId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([itemId])
  @@map("product_bom_lines")
}

/// Per-branch stocking parameters for a product: minimum / maximum stock levels,
/// the reorder trigger level, and the replenishment lead time (in days). One row
/// per branch the user has set values for; branches with no row fall back to
/// zero. `branchId` is a plain cross-domain id -> Cpanel Branch (mirrors
/// ProductCompany.companyId — no cross-domain FK). Edited on Products - Packed;
/// new branches are picked up automatically because the editor renders from the
/// live branch list, not from stored rows.
/// Which delivery trips a product goes out on.
///
/// The trips themselves are LookupValues (lookup code DELIVERY_TRIP, Inventory
/// module), not an enum, so they can be renamed and added to from the Lookups
/// screen without a code change — unlike the production days, which are fixed by
/// the calendar. Per the cross-domain rule the LookupValue lives in Cpanel, so
/// it is referenced by a plain id with no relation.
model ProductDeliveryTrip {
  id            Int @id @default(autoincrement())
  productId     Int
  lookupValueId Int // -> Cpanel LookupValue (a DELIVERY_TRIP value)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, lookupValueId])
  @@index([productId])
  @@map("product_delivery_trips")
}

/// One cell of a product's DISCOUNT MATRIX: the maximum discount `percentage`
/// the holders of one authority level may give on this product at billing time.
///
/// The levels are LookupValues (lookup code DISCOUNT_LEVEL, Inventory module)
/// rather than columns or an enum, for the same reason as the delivery trips —
/// Salesman / Branch Manager / Operations Manager / Directors are the user's org
/// roles, and adding a fifth or renaming one must not need a developer. Per the
/// cross-domain rule the LookupValue lives in Cpanel, so it is referenced by a
/// plain id with no relation.
///
/// The percentage is stored HERE, per product, because it varies per product;
/// only rows the user has actually set exist, and a level with no row means no
/// discount. Rows are kept only while the product `canSell` — the matrix is a
/// selling attribute, so it is cleared with the rest of them.
///
/// Which level a given user holds is resolved from their UserGroup
/// (UserGroup.discountLevelId), so a login maps to a ceiling.
model ProductDiscount {
  id            Int   @id @default(autoincrement())
  productId     Int
  lookupValueId Int // -> Cpanel LookupValue (a DISCOUNT_LEVEL value)
  percentage    Float @default(0) // max discount % this level may give, 0-100

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, lookupValueId])
  @@index([productId])
  @@map("product_discounts")
}

model ProductBranchStock {
  id           Int   @id @default(autoincrement())
  productId    Int
  branchId     Int // -> Cpanel Branch, by id (no cross-domain FK)
  minStock     Float @default(0)
  maxStock     Float @default(0)
  reorderLevel Float @default(0)
  leadTimeDays Int   @default(0)
  // Where this product is put away in this branch: its default store and the
  // rack within it. Plain ids (-> Store / Rack) — the product's home location
  // for production put-away, transfers and delivery.
  defaultStoreId Int?
  defaultRackId  Int?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@index([productId])
  @@index([branchId])
  @@map("product_branch_stocks")
}

/// What one COMPANY does with this product, and the costing it is traced
/// against there. A row's existence is what makes the product available in that
/// company — there is no "all companies" shortcut, because costing has to be
/// named per company and a blanket flag would leave nothing to hang it on.
///
/// The roles are not exclusive: EK Food Products both PRODUCES and SELLS (to
/// Bake House and to outside customers), while a trading company only buys and
/// sells. `canProduce` off therefore means "buys it in" rather than "doesn't
/// handle it".
///
/// Costing: ONE cost centre per company — buying, making and selling in that
/// company all hit the same one. What varies is the ACTIVITY, so a producer
/// names a cost object per activity (recipe → Bakery, packing → Packing) while
/// a company that only buys and sells names a single one. All are plain
/// cross-domain ids -> Cpanel CostCenter / CostObject.
model ProductCompany {
  id         Int     @id @default(autoincrement())
  productId  Int
  companyId  Int // -> Cpanel Company, by id (no cross-domain FK)
  canProduce Boolean @default(false) // makes it in-house; false = buys it in
  canSell    Boolean @default(true)

  costCenterId        Int? // the company's cost centre for this product
  recipeCostObjectId  Int? // producer + product hasRecipe
  packingCostObjectId Int? // producer + product hasPacking
  costObjectId        Int? // non-producer (buy & sell): its single cost object

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, companyId])
  @@index([companyId])
  @@map("product_companies")
}

// ===========================================================================
// Stock movement subsystem
//
// One flat CHILD ledger (StockLedger) records every goods in/out line for ALL
// transaction types; each type has its own MASTER (header) table — the first
// is OpeningStock. A line's parent document is (transactionType, documentId).
// The ledger is intentionally a flat table of plain-id foreign keys (a ledger,
// not a relational graph); category / primary-group / parent-group are
// denormalized snapshots from the item at entry time for join-free reporting.
// ===========================================================================

/// The kind of stock movement (drives which master/document it belongs to).
enum StockTxnType {
  OPENING_STOCK // Opening Stock Journal
  PURCHASE // Goods Receipt Note (stock IN)
  SALE // Delivery Note (stock OUT)
  PRODUCTION // Production Receipt Note (finished goods in)
  TRANSFER // Stock Journal (store-to-store, intra/inter-company)
  ADJUSTMENT // Stock Adjustment (add/remove)
  SALES_RETURN // Sales Return — customer returns goods into stock (IN)
  PURCHASE_RETURN // Purchase Return — goods returned to the supplier (OUT)
  CONSUMPTION // Goods Issue Note — internal consumption (stock OUT)
}

/// Stock location — a store / warehouse / godown within a company. Stock is
/// held and transferred between stores (same company or across companies).
/// companyId / branchId are plain cross-domain ids.
model Store {
  id        Int      @id @default(autoincrement())
  companyId Int // -> Cpanel Company (plain id)
  branchId  Int? // -> Cpanel Branch (plain id, optional)
  code      String // ST-#### per company (system-generated)
  name      String
  address   String?
  isDefault Boolean  @default(false) // the branch's default store (auto-picked in combos)
  isActive  Boolean  @default(true)
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  racks Rack[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("stores")
}

/// A rack / shelf / bin inside a Store — the finest stock location. A product is
/// given a default store + rack per branch (see ProductBranchStock), so produced
/// and received goods have a home to be put away in. `storeId` is a real relation
/// (same domain); `companyId` is denormalized from the store for per-company
/// scoping. `code` is RK-#### per store (system-generated).
model Rack {
  id        Int      @id @default(autoincrement())
  companyId Int // -> Cpanel Company (plain id); denormalized from the store
  storeId   Int
  code      String // RK-#### per store (system-generated)
  name      String
  isDefault Boolean  @default(false) // the store's default rack (auto-picked in combos)
  isActive  Boolean  @default(true)
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
  @@index([storeId])
  @@index([companyId])
  @@map("racks")
}

/// A stock batch / lot. `batchNo1` is our system code
/// (CompanyCode-YYMMDD-####); `batchNo2` is the supplier's batch on the goods.
/// Generated on stock-in (opening stock / purchase); manufactured goods reuse
/// the product batch created during production. Item/Product refs are plain ids.
model StockBatch {
  id         Int       @id @default(autoincrement())
  companyId  Int
  batchNo1   String // system-generated
  batchNo2   String? // supplier's batch number
  itemId     Int?
  productId  Int?
  expiryDate DateTime?
  createdAt  DateTime  @default(now())

  @@unique([companyId, batchNo1])
  @@index([companyId, itemId])
  @@index([companyId, productId])
  @@map("stock_batches")
}

/// Universal goods in/out ledger — one row per movement line for every
/// transaction type. Flat plain-id foreign keys by design.
model StockLedger {
  id                 Int          @id @default(autoincrement())
  date               DateTime
  companyId          Int
  branchId           Int?
  storeId            Int
  transactionType    StockTxnType
  transactionSubtype String?
  documentId         Int // parent master row id (e.g. OpeningStock.id)
  documentNo         String
  reference          String?
  categoryId         Int? // denormalized snapshot from the item/product
  primaryGroupId     Int? // level-1 group in the item's group chain
  parentGroupId      Int? // the item's leaf group
  // Costing dimensions, denormalized like the classification above so cost
  // centre / object reporting is a plain ledger query. Resolved from the
  // product's row for THIS company (ProductCompany), by activity: production
  // and receipts take the recipe object, packing the packing one, and an issue
  // takes them from the requisition it fulfils. Null where the product has no
  // costing set, or for movements that aren't traced (opening stock, transfers).
  costCenterId       Int?
  costObjectId       Int?
  itemId             Int?
  productId          Int?
  batchId            Int?
  batchNo1           String? // system batch number
  batchNo2           String? // supplier batch number
  expiryDate         DateTime?
  qtyIn              Float        @default(0)
  qtyOut             Float        @default(0)
  unitId             Int
  unitPrice          Float        @default(0)
  // What was actually written on the supplier's delivery note / invoice, when
  // the line was entered in the pack rather than the stock unit: 1 Bottle, not
  // the 200 g it becomes. qtyIn/qtyOut/unitId/unitPrice above stay in the STOCK
  // unit and remain the only thing balances, FEFO and costing read — these two
  // exist so reopening or reprinting the document shows what was received.
  // Null on a line typed in the stock unit, which is already its own record.
  enteredQty         Float?
  enteredUnitId      Int? // -> Unit (plain id, like every other id on this row)
  // The rate as invoiced, per PACK (50 a bottle) beside unitPrice's per-gram
  // 0.25. Stored rather than divided back out of unitPrice on demand: the two
  // rates are read together on every purchase report, and re-deriving one from
  // the other reintroduces the rounding that storing both avoids.
  enteredUnitPrice   Float?
  // Tax captured on the movement line.
  cgst               Float        @default(0)
  sgst               Float        @default(0)
  igst               Float        @default(0)
  cess               Float        @default(0)
  // Pricing snapshots captured on the movement line.
  costPrice          Float        @default(0)
  intercompanyPrice  Float        @default(0)
  wholesalePrice     Float        @default(0)
  retailPrice        Float        @default(0)
  mrp                Float        @default(0)
  createdAt          DateTime     @default(now())

  @@index([companyId, storeId])
  @@index([companyId, itemId])
  @@index([companyId, productId])
  @@index([transactionType, documentId])
  @@index([batchId])
  // Drives the cost centre / object performance reporting.
  @@index([companyId, costObjectId, date])
  @@map("stock_ledger")
}

/// Opening Stock document (header). Its lines are the StockLedger rows with
/// transactionType = OPENING_STOCK and documentId = this row's id.
model OpeningStock {
  id        Int      @id @default(autoincrement())
  companyId Int
  docNo     String // OS-##### per company
  docDate   DateTime
  storeId   Int
  reference String?
  notes     String?
  status    String   @default("POSTED") // DRAFT | POSTED
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, docNo])
  @@index([companyId])
  @@map("opening_stock")
}

/// Generic stock-movement document (header) for the Inventory Transactions menu:
/// Goods Receipt Note (PURCHASE), Delivery Note (SALE), Goods Return Note
/// (RETURN) and Goods Issue Note / Consumption (CONSUMPTION). Its lines are the
/// StockLedger rows with the matching `type` and documentId = this row's id.
/// IN types (PURCHASE, RETURN) create a batch per line like Opening Stock; OUT
/// types (SALE, CONSUMPTION) decrement store stock (qtyOut). docNo is unique per
/// company AND type, so each note type keeps its own sequence.
model StockTransaction {
  id        Int          @id @default(autoincrement())
  companyId Int
  branchId  Int? // -> Cpanel Branch (plain id); null for companies without branches
  type      StockTxnType
  docNo     String
  docDate   DateTime
  storeId   Int
  // Goods Receipt Note only: the supplier the goods came from and the purchase
  // order they fulfil. supplierId -> Accounts Supplier (plain cross-domain id);
  // purchaseOrderRef is free text for now (later a real PO link).
  supplierId       Int?
  purchaseOrderRef String?
  // Goods Receipt Note only: the intercompany Dispatch these goods arrived on
  // (-> CRM Dispatch, plain cross-domain id). Unique — a shipment is received
  // once; deleting the receipt reopens the dispatch. Null on an ordinary
  // external-supplier receipt.
  dispatchId       Int?         @unique
  dispatchNo       String? // snapshot
  // Costing the whole document is charged to. Raw-material ITEMS carry no
  // costing of their own, so an issue raised outside a Material Request has
  // nothing to inherit — this is where the user says what it is for. When set
  // it OVERRIDES the per-line product costing, because an explicit choice on
  // the document is a deliberate attribution (issuing finished goods to the
  // staff mess belongs to the mess, not to the line that baked them).
  // Plain cross-domain ids -> Cpanel CostCenter / CostObject.
  costCenterId Int?
  costObjectId Int?
  reference String?
  notes     String?
  status    String       @default("POSTED") // DRAFT | POSTED
  isLocked  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([companyId, type, docNo])
  @@index([companyId, branchId, type])
  @@map("stock_transactions")
}

// ---------------------------------------------------------------------------
// Stock reservations — soft holds placed on batches before goods move.
// ---------------------------------------------------------------------------

enum StockReservationStatus {
  ACTIVE // holding stock; counts against what others can reserve
  RELEASED // given back (line cancelled, order rejected, re-reserved)
  CONSUMED // the goods actually moved; the hold has served its purpose
}

/// A hold on a quantity of one BATCH at one STORE, for one document line.
///
/// Nothing here moves stock — a reservation is a promise, and the StockLedger
/// stays the only record of physical movement. What it does is make the quantity
/// invisible to everyone else: available = (ledger qtyIn - qtyOut) - SUM(ACTIVE
/// reservations). Without that subtraction two orders would each "reserve" the
/// same last 12 boxes and the clash would surface at dispatch.
///
/// One row PER BATCH: FEFO splits a single order line across as many batches as
/// it takes to fill, so a line's reserved quantity is the SUM of its rows.
///
/// `quantity` is always in the product's own stock unit — the ledger has no unit
/// discipline (it stamps the master's unit on every row regardless of what was
/// passed), so a reservation must not invent one either.
///
/// Cross-domain rule: documentId points at another domain's row (a CRM purchase
/// order line today), so it is a plain Int with no relation. batchId/storeId are
/// plain ids too, matching StockLedger's own style.
model StockReservation {
  id        Int @id @default(autoincrement())
  companyId Int // the owner of the stock — the supplier company
  storeId   Int // where this held stock physically sits
  productId Int
  batchId   Int
  quantity  Float // in the product's stock unit

  // What the hold is for. documentType keeps this reusable beyond the ICPO
  // (a sales order, a work order) without a column per document kind.
  documentType   String // e.g. 'PURCHASE_ORDER'
  documentId     Int // the order header id
  documentLineId Int // the order line id — a line reserves independently

  status          StockReservationStatus @default(ACTIVE)
  createdByUserId Int
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  // Available-stock maths filters on (product, status) and nets off per batch.
  @@index([companyId, productId, status])
  @@index([batchId, status])
  // Release/consume sweep a whole document, or one line of it.
  @@index([documentType, documentId, status])
  @@index([documentLineId])
  @@map("stock_reservations")
}
