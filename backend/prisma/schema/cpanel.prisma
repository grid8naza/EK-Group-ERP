// Cpanel domain — the Control Panel module's tables.
//
// Multi-company: each Company is an isolated tenant. The cpanel config tables
// (objects, menus, user groups, widgets, dashboards) carry a companyId so every
// company is configured independently ("separate cpanel per company"). The
// Module catalog and Lookups stay global; which modules are enabled is decided
// per company via CompanyModule.
//
// Every model here is FK-connected to the rest of Cpanel, which is why they all
// live in one domain file. A future module (CRM, Accounts, ...) gets its OWN
// file and references these by id only — never via @relation. See schema.prisma.

// ---------------------------------------------------------------------------
// Module Master — global catalog of module types. Enablement is per-company
// via CompanyModule.
// ---------------------------------------------------------------------------

model Module {
  id          Int      @id @default(autoincrement())
  code        String   @unique // e.g. CPANEL, CRM, ACCOUNTS
  name        String
  description String?
  icon        String? // lucide icon name, e.g. "settings"
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isCore      Boolean  @default(false) // core modules (Cpanel) cannot be removed
  isLocked    Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  objects             ObjectMaster[]
  mainMenus           MainMenu[]
  lookups             Lookup[]
  userGroups          UserGroupModule[]
  userAccess          UserModule[]
  widgets             Widget[]
  dashboards          Dashboard[]
  companyModules      CompanyModule[]
  defaultForUsers     User[]            @relation("UserDefaultModule")
  defaultForCompanies UserCompany[]     @relation("UserCompanyDefaultModule")

  @@map("modules")
}

// ---------------------------------------------------------------------------
// Lookups — generic configurable dropdowns (global reference data).
// ---------------------------------------------------------------------------

model Lookup {
  id          Int      @id @default(autoincrement())
  code        String   @unique // e.g. DEVELOPERS, ICONS
  name        String
  description String?
  moduleId    Int? // the module this lookup belongs to (null = global / all modules)
  /// The lookup whose values THIS lookup's values sit under — Transaction
  /// Subtype under Transaction Type. Null in a flat lookup, which is most.
  ///
  /// Declaring the pairing here is what makes the rule enforceable rather than
  /// conventional: every value of a lookup that has a parent must name one of
  /// that parent's values, so a subtype list can never hold an entry belonging
  /// to no type. See LookupValue.parentValueId for the link itself.
  parentLookupId Int?
  isSystem    Boolean  @default(false)
  isLocked    Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module Module?       @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  values LookupValue[]

  // Restrict: a list other lists hang from cannot simply be deleted.
  parentLookup Lookup?  @relation("LookupParent", fields: [parentLookupId], references: [id], onDelete: Restrict)
  childLookups Lookup[] @relation("LookupParent")

  @@index([moduleId])
  @@index([parentLookupId])
  @@map("lookups")
}

model LookupValue {
  id        Int      @id @default(autoincrement())
  lookupId  Int
  value     String
  label     String
  alias     String? // optional custom name for this value (used where a bespoke label is needed)
  remarks   String? // free-text remarks (was "extra")
  /// The value this one sits UNDER, where a pair of lookups is read as one
  /// two-level list — a transaction subtype under its type ("B2C Sale" under
  /// "Sale"). Null in a flat lookup, which is most of them.
  ///
  /// The parent lives in a DIFFERENT lookup (subtype values point at type
  /// values), so this is a link across two lists rather than a tree within one.
  /// That is what lets the type list stay short and the subtype list stay
  /// filtered to the type in hand.
  parentValueId Int?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  isLocked  Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lookup Lookup @relation(fields: [lookupId], references: [id], onDelete: Cascade)

  // Restrict, not Cascade: removing "Sale" must not silently take its three
  // subtypes — and every document already classified by them — with it.
  parent   LookupValue?  @relation("LookupValueTree", fields: [parentValueId], references: [id], onDelete: Restrict)
  children LookupValue[] @relation("LookupValueTree")

  docsAsTxnType             Document[]  @relation("DocTxnType")
  docsAsTxnSubtype          Document[]  @relation("DocTxnSubtype")
  userGroupsAsDiscountLevel UserGroup[] @relation("UserGroupDiscountLevel")

  @@unique([lookupId, value])
  @@index([parentValueId])
  @@map("lookup_values")
}

// ---------------------------------------------------------------------------
// Company Master — the tenant. Each company is configured independently.
// ---------------------------------------------------------------------------

model Company {
  id        Int     @id @default(autoincrement())
  code      String  @unique
  name      String
  shortName String? // brand short name shown in the sidebar
  legalName String?
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  country   String?
  logo      String?

  // --- Financial / statutory details ---
  financialYearStartMonth Int? // 1 = January … 12 = December
  financialYearEndMonth   Int? // 1 = January … 12 = December
  booksStartDate          DateTime? // books of accounts start from
  // The FIRST of the two data-entry checkpoints: what this company works in at
  // all. The second is per ledger account (Account.hasCostCenter /
  // hasCostObject). Both are resolved together in src/common/entry-rules.ts —
  // whichever is narrower wins, so a company with cost centres switched off is
  // never asked for one whatever an account says.
  costCenterApplicable    Boolean   @default(false)
  costObjectApplicable    Boolean   @default(false) // when true, cost objects can be created (requires costCenterApplicable)
  branchApplicable        Boolean   @default(false) // when true, branches can be created for this company
  currencyId              Int?
  cin                     String? // Corporate Identification Number (21)
  gstin                   String? // GST identification number (15)
  pan                     String? // PAN (12)
  tan                     String? // TAN (10)
  ptrn                    String? // Professional Tax Registration No. (12)
  ptec                    String? // Professional Tax Enrolment Certificate (12)

  isActive  Boolean  @default(true)
  isLocked  Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currency    Currency?       @relation(fields: [currencyId], references: [id])
  modules     CompanyModule[]
  users       UserCompany[]
  userModules UserModule[]
  mainMenus   MainMenu[]
  userGroups  UserGroup[]
  widgets     Widget[]
  dashboards  Dashboard[]
  branches    Branch[]
  costCenters CostCenter[]
  costObjects CostObject[]

  @@map("companies")
}

// ---------------------------------------------------------------------------
// Cost Center & Cost Object masters — per company. Only relevant when the
// company has costCenterApplicable / costObjectApplicable. A cost object always
// lives under a cost center.
//
// Two fixed levels, and they mean particular things:
//   · a COST CENTER is a function of the company — Operations, Admin Support —
//     i.e. its divisions;
//   · a COST OBJECT is a department within that division.
// Both are company-scoped and neither is branch-scoped: an accounting entry
// carries its branch in its own right, so hanging a branch off the centre as
// well would capture the same fact twice and split "Operations" into one
// centre per branch. This is where this ERP departs from Annexure D.7, which
// models an open hierarchy of centres within a branch.
// ---------------------------------------------------------------------------

model CostCenter {
  id          Int      @id @default(autoincrement())
  companyId   Int
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  isLocked    Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  costObjects CostObject[]

  @@unique([companyId, code])
  @@map("cost_centers")
}

model CostObject {
  id           Int      @id @default(autoincrement())
  companyId    Int
  costCenterId Int
  code         String
  name         String
  description  String?
  /// What KIND of department this is — DEPT, KITCHEN, CAFE, COUNTER, MESS,
  /// VEHICLE, PROJECT. A plain code -> Accounts CostCentreCategory (no
  /// relation: the cross-domain rule). Optional, and only used for reporting:
  /// it is what lets cost per meal, contribution per counter and running cost
  /// per vehicle come out of the ledger (Annexure D.7, D.14).
  categoryCode String?
  isActive     Boolean  @default(true)
  isLocked     Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  costCenter CostCenter @relation(fields: [costCenterId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@map("cost_objects")
}

// ---------------------------------------------------------------------------
// Branch Master — a company's operating locations. Only relevant when the
// company has branchApplicable = true. A branch is purely a context selector
// for now (no business table is partitioned by branch yet); UserBranch gates
// which branches a user may switch to.
// ---------------------------------------------------------------------------

model Branch {
  id        Int      @id @default(autoincrement())
  companyId Int
  code      String
  name      String
  address   String?
  city      String?
  state     String?
  country   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  isLocked  Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userBranches UserBranch[]
  dashboards   Dashboard[]

  @@unique([companyId, code])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Currency master — global reference data; the source for a company's currency.
// ---------------------------------------------------------------------------

model Currency {
  id             Int      @id @default(autoincrement())
  code           String   @unique // e.g. INR, USD
  name           String // e.g. Indian Rupee
  symbol         String // e.g. ₹
  fractionalUnit String // e.g. Paisa
  isActive       Boolean  @default(true)
  isLocked       Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  companies Company[]

  @@map("currencies")
}

// Which modules are enabled for a company ("module selected per company").
model CompanyModule {
  id        Int     @id @default(autoincrement())
  companyId Int
  moduleId  Int
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleId])
  @@map("company_modules")
}

// Which companies a user may log into. isDefault selects the company that
// loads automatically after login. defaultModuleId selects, within that
// company, the module that loads automatically (must be one assigned to the
// user in this company via UserModule).
model UserCompany {
  id              Int     @id @default(autoincrement())
  userId          Int
  companyId       Int
  isDefault       Boolean @default(false)
  defaultModuleId Int?

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultModule Module? @relation("UserCompanyDefaultModule", fields: [defaultModuleId], references: [id], onDelete: SetNull)

  @@unique([userId, companyId])
  @@map("user_companies")
}

// ---------------------------------------------------------------------------
// Object Master — global registry of every Table/Form/Report/Dashboard. Object
// definitions (e.g. "HR Master") are shared across all companies, so they are
// NOT company-scoped; only menus/privileges that reference them are per company.
// ---------------------------------------------------------------------------

model ObjectMaster {
  id          Int        @id @default(autoincrement())
  moduleId    Int
  author      String
  objectType  ObjectType
  objectName  String
  notes       String?
  showInMenu  Boolean    @default(false)
  nameInMenu  String?
  description String?
  route       String? // e.g. /crm/enquiry/amc
  icon        String?
  help        Boolean    @default(false)
  attachment  String?
  isSystem    Boolean    @default(false) // system objects (Cpanel core) vs user objects (e.g. HR Master); system are visible only to super admins
  isLocked    Boolean    @default(false) // when locked, the object must be unlocked before it can be edited or deleted
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  module     Module           @relation(fields: [moduleId], references: [id])
  revisions  ObjectRevision[]
  subMenus   SubMenu[]
  dashboards Dashboard[]

  @@map("object_master")
}

model ObjectRevision {
  id             Int      @id @default(autoincrement())
  objectId       Int
  revisionNumber String
  revisedBy      String
  reason         String?
  changesDone    String?
  dateRevised    DateTime @default(now())

  object ObjectMaster @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@map("object_revisions")
}

// ---------------------------------------------------------------------------
// Menu Setup — Main Menu with nested Sub Menus (per company).
// ---------------------------------------------------------------------------

model MainMenu {
  id         Int        @id @default(autoincrement())
  companyId  Int
  moduleId   Int
  sortOrder  Int        @default(0)
  menuName   String
  objectType ObjectType @default(FORM)
  isUserMenu Boolean    @default(true)
  icon       String?
  isLocked   Boolean    @default(false) // when locked, must be unlocked before edit/delete
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module     Module                @relation(fields: [moduleId], references: [id])
  subMenus   SubMenu[]
  privileges GroupMainMenuAccess[]

  @@map("main_menus")
}

model SubMenu {
  id          Int        @id @default(autoincrement())
  mainMenuId  Int
  objectId    Int?
  sortOrder   Int        @default(0)
  subMenuName String
  objectType  ObjectType @default(FORM)
  description String?
  route       String?
  icon        String?
  isLocked    Boolean    @default(false) // when locked, must be unlocked before edit/delete
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  mainMenu   MainMenu                @relation(fields: [mainMenuId], references: [id], onDelete: Cascade)
  object     ObjectMaster?           @relation(fields: [objectId], references: [id])
  privileges GroupSubMenuPrivilege[]

  @@map("sub_menus")
}

// ---------------------------------------------------------------------------
// User Groups & Privileges (per company).
// ---------------------------------------------------------------------------

model UserGroup {
  id              Int      @id @default(autoincrement())
  companyId       Int
  name            String
  description     String?
  /// Discount authority of this group's members — a DISCOUNT_LEVEL LookupValue
  /// (Inventory module). This is what lets billing turn a login into a discount
  /// ceiling: the group gives the level, and the level indexes the product's
  /// discount matrix (ProductDiscount) for the per-product percentage. Null =
  /// the group may give no discount. Set here rather than per user so it is
  /// maintained once per role; both live in Cpanel, so it is a real relation.
  discountLevelId Int?
  isLocked        Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  discountLevel   LookupValue?            @relation("UserGroupDiscountLevel", fields: [discountLevelId], references: [id], onDelete: SetNull)
  modules         UserGroupModule[]
  mainMenuAccess  GroupMainMenuAccess[]
  subMenuPrivs    GroupSubMenuPrivilege[]
  userAssignments UserGroupAssignment[]
  dashboardAccess GroupDashboard[]

  @@unique([companyId, name])
  @@index([discountLevelId])
  @@map("user_groups")
}

model UserGroupModule {
  id          Int @id @default(autoincrement())
  userGroupId Int
  moduleId    Int

  userGroup UserGroup @relation(fields: [userGroupId], references: [id], onDelete: Cascade)
  module    Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userGroupId, moduleId])
  @@map("user_group_modules")
}

model GroupMainMenuAccess {
  id          Int     @id @default(autoincrement())
  userGroupId Int
  mainMenuId  Int
  visible     Boolean @default(false)

  userGroup UserGroup @relation(fields: [userGroupId], references: [id], onDelete: Cascade)
  mainMenu  MainMenu  @relation(fields: [mainMenuId], references: [id], onDelete: Cascade)

  @@unique([userGroupId, mainMenuId])
  @@map("group_main_menu_access")
}

model GroupSubMenuPrivilege {
  id               Int     @id @default(autoincrement())
  userGroupId      Int
  subMenuId        Int
  canMenu          Boolean @default(false)
  canView          Boolean @default(false)
  canAdd           Boolean @default(false)
  canEdit          Boolean @default(false)
  canDelete        Boolean @default(false)
  canLock          Boolean @default(false)
  canUnlock        Boolean @default(false)
  canPrint         Boolean @default(false)
  canDownloadPdf   Boolean @default(false)
  canDownloadExcel Boolean @default(false)

  userGroup UserGroup @relation(fields: [userGroupId], references: [id], onDelete: Cascade)
  subMenu   SubMenu   @relation(fields: [subMenuId], references: [id], onDelete: Cascade)

  @@unique([userGroupId, subMenuId])
  @@map("group_sub_menu_privileges")
}

// ---------------------------------------------------------------------------
// Widgets — per-company-and-module catalog of dashboard widgets.
// ---------------------------------------------------------------------------

model Widget {
  id          Int        @id @default(autoincrement())
  companyId   Int? // null = global (core modules like Cpanel); else company-scoped
  moduleId    Int
  code        String // unique per company+module (per-module for global widgets)
  name        String
  description String?
  type        WidgetType @default(METRIC)
  config      Json? // type-specific settings (source / text / url / height)
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  isLocked    Boolean    @default(false) // when locked, must be unlocked before edit/delete
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  company    Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module     Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  placements DashboardWidget[]

  @@unique([companyId, moduleId, code])
  @@map("widgets")
}

// ---------------------------------------------------------------------------
// Dashboards — multiple named dashboards per (company, module), optionally
// scoped to a branch. User groups choose which dashboards they see via
// GroupDashboard, so two or more selected dashboards in a module all appear in
// that module's dashboard menu. Widgets have a default order; each user can
// override the arrangement (saved in UserDashboardLayout).
// ---------------------------------------------------------------------------

model Dashboard {
  id        Int      @id @default(autoincrement())
  companyId Int? // null = global (core modules like Cpanel); else company-scoped
  moduleId  Int
  branchId  Int? // null = company-wide; otherwise scoped to one branch
  objectId  Int? // optional link to its ObjectMaster DASHBOARD object
  name      String
  icon      String?
  header    Json? // header banner appearance (theme / colors / subtitle / layout)
  sortOrder Int      @default(0)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  isLocked  Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company?              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module      Module                @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  branch      Branch?               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  object      ObjectMaster?         @relation(fields: [objectId], references: [id], onDelete: SetNull)
  widgets     DashboardWidget[]
  groupAccess GroupDashboard[]
  userLayouts UserDashboardLayout[]

  @@map("dashboards")
}

// Which dashboards a user group sees. Selecting two or more dashboards in a
// module makes all of them appear in that module's dashboard menu for the
// group. Mirrors the per-group menu/privilege joins.
model GroupDashboard {
  id          Int @id @default(autoincrement())
  userGroupId Int
  dashboardId Int

  userGroup UserGroup @relation(fields: [userGroupId], references: [id], onDelete: Cascade)
  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@unique([userGroupId, dashboardId])
  @@map("group_dashboards")
}

// Default widget placement on a dashboard.
model DashboardWidget {
  id          Int @id @default(autoincrement())
  dashboardId Int
  widgetId    Int
  sortOrder   Int @default(0)
  width       Int @default(1) // grid span hint (1 = stat, 2 = wide)

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  widget    Widget    @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@unique([dashboardId, widgetId])
  @@map("dashboard_widgets")
}

// A user's personal arrangement of a dashboard's widgets (drag-and-drop).
model UserDashboardLayout {
  id          Int      @id @default(autoincrement())
  userId      Int
  dashboardId Int
  layout      Json // [{ widgetId, sortOrder, hidden }]
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@unique([userId, dashboardId])
  @@map("user_dashboard_layouts")
}

// ---------------------------------------------------------------------------
// Users & Data Security. A user is a global identity with access to one or
// more companies; their group (and therefore rights) is decided per company.
// ---------------------------------------------------------------------------

model User {
  id              Int          @id @default(autoincrement())
  userCode        String       @unique
  username        String       @unique
  name            String
  email           String?      @unique
  passwordHash    String
  mobile          String?
  mobileMac       String?
  webEnabled      Boolean      @default(true) // can sign in to the web app
  mobileEnabled   Boolean      @default(false) // can sign in to the mobile app
  computerMac     String?
  securityType    SecurityType @default(PASSWORD)
  isSuperAdmin    Boolean      @default(false)
  isActive        Boolean      @default(true)
  isLocked        Boolean      @default(false) // when locked, must be unlocked before edit/delete
  remarks         String?
  defaultModuleId Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  groupAssignments UserGroupAssignment[]
  modules          UserModule[]
  companies        UserCompany[]
  branches         UserBranch[]
  dashboardLayouts UserDashboardLayout[]
  defaultModule    Module?               @relation("UserDefaultModule", fields: [defaultModuleId], references: [id])

  @@map("users")
}

// Modules assigned to a user *within a company*. A user can be given a
// different module set per company (a subset of the company's enabled modules).
model UserModule {
  id        Int @id @default(autoincrement())
  userId    Int
  companyId Int
  moduleId  Int

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId, moduleId])
  @@map("user_modules")
}

// Assigns a user to a user group. Because groups carry a companyId, a user's
// effective group (and rights) varies by company.
model UserGroupAssignment {
  id          Int @id @default(autoincrement())
  userId      Int
  userGroupId Int

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userGroup UserGroup @relation(fields: [userGroupId], references: [id], onDelete: Cascade)

  @@unique([userId, userGroupId])
  @@map("user_group_assignments")
}

// Branches a user may access, within a branch-applicable company. Mirrors
// UserCompany: the top-bar branch switcher lists only the user's branches.
model UserBranch {
  id        Int     @id @default(autoincrement())
  userId    Int
  branchId  Int
  isDefault Boolean @default(false) // the user's default branch within its company

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@map("user_branches")
}

// ---------------------------------------------------------------------------
// Security settings — a single global row (id = 1) holding the "high security
// password". This is a second gate, separate from any user's login password,
// that must be supplied before sensitive system operations (database backup /
// restore). Stored only as a bcrypt hash.
// ---------------------------------------------------------------------------
model SecuritySetting {
  id                       Int      @id @default(1)
  highSecurityPasswordHash String
  updatedAt                DateTime @updatedAt

  @@map("security_settings")
}

// ---------------------------------------------------------------------------
// Login screen customization — a single global row (id = 1). The login page is
// shown before any company is selected, so this branding is app-wide, not
// company-scoped. `config` is a JSON blob (logo, styled heading/description/
// copyright, form & page colors, selected background media id). Mirrors the
// dashboard header banner pattern (Dashboard.header).
// ---------------------------------------------------------------------------
model LoginScreenConfig {
  id        Int      @id @default(1)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("login_screen_config")
}

// Uploaded media for the login background library. One of these may be chosen
// as the page backdrop (referenced by LoginScreenConfig.config.backgroundMediaId).
model LoginMedia {
  id           Int            @id @default(autoincrement())
  kind         LoginMediaKind
  url          String
  originalName String
  sizeBytes    Int
  createdAt    DateTime       @default(now())

  @@map("login_media")
}

// ---------------------------------------------------------------------------
// Software information (singleton, id=1). Global licence/branding details shown
// as the app's extreme top-left brand tile (logo + software name); the full
// panel opens when the tile is clicked.
// ---------------------------------------------------------------------------
model SoftwareInfo {
  id                 Int       @id @default(1)
  companyName        String?
  address            String?
  email              String?
  contactNumber      String?
  softwareName       String?
  softwareVersion    String?
  licenceKey         String?
  subscriptionExpiry DateTime?
  logoUrl            String?
  logoSize           Int? // displayed brand-logo size in px (null = default)
  symbolLogoUrl      String? // symbol-only mark shown when the sidebar is collapsed
  symbolLogoSize     Int? // displayed symbol-logo size in px (null = default)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("software_info")
}

// ---------------------------------------------------------------------------
// Document numbering
//
// `Document` is a global master of document TYPES (Opening Stock, GRN, vouchers…).
// Each company configures its own sequencer for a document via a
// DocumentNumberingRule (prefix/suffix/padding/start + renumber period). The
// rule also carries the running counter state so numbers reset per period.
// ---------------------------------------------------------------------------
model Document {
  id                   Int      @id @default(autoincrement())
  code                 String   @unique // stable code services reference (e.g. OPENING_STOCK)
  name                 String
  description          String?
  isSystem             Boolean  @default(false) // seeded, wired to a real document flow
  isActive             Boolean  @default(true)
  isLocked             Boolean  @default(false)
  // The inventory transaction type / subtype this document posts as, chosen from
  // the "Inventory Transaction Type" / "…Subtype" lookups.
  transactionTypeId    Int?
  transactionSubtypeId Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  numberingRules     DocumentNumberingRule[]
  transactionType    LookupValue?            @relation("DocTxnType", fields: [transactionTypeId], references: [id], onDelete: SetNull)
  transactionSubtype LookupValue?            @relation("DocTxnSubtype", fields: [transactionSubtypeId], references: [id], onDelete: SetNull)

  @@map("documents")
}

/// When the sequencer resets to the starting number.
enum NumberingRenumber {
  NEVER
  MONTHLY
  YEARLY
}

/// Where the month/year period token sits relative to the configured suffix.
enum NumberingPeriodPosition {
  BEFORE_SUFFIX
  AFTER_SUFFIX
}

/// A company's numbering rule + running counter for one document type.
model DocumentNumberingRule {
  id             Int                     @id @default(autoincrement())
  companyId      Int // -> Cpanel Company (plain id)
  documentId     Int
  prefixEnabled  Boolean                 @default(true)
  prefixValue    String?
  startingNo     Int                     @default(1)
  suffixEnabled  Boolean                 @default(false)
  suffixValue    String?
  paddingLength  Int                     @default(5)
  renumber       NumberingRenumber       @default(NEVER)
  periodPosition NumberingPeriodPosition @default(BEFORE_SUFFIX)
  isLocked       Boolean                 @default(false)
  // No running counter is stored: the next number is read back from the
  // documents themselves (MAX + 1, per period), so clearing a company's
  // documents restarts its numbering instead of stranding a counter nothing
  // backs. See DocumentNumberingService.
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([companyId, documentId])
  @@index([companyId])
  @@map("document_numbering_rules")
}

/// Date part of a generated batch number.
enum BatchDateFormat {
  YYMMDD
  YYYYMMDD
}

/// How the batch counter resets.
enum BatchRenumber {
  DAILY
  MONTHLY
  YEARLY
}

/// Per company + branch sequencer for stock batch numbers. A batch number is
/// `{prefix}{date}-{padded}` where date is YY/YYYY-MM-DD and the counter resets
/// per the renumber period. Rules are per branch; branch-less batches use the
/// built-in `CompanyCode-YYMMDD-####` fallback (no company-level rule).
model BatchNumberingRule {
  id            Int             @id @default(autoincrement())
  companyId     Int // -> Cpanel Company (plain id)
  branchId      Int? // -> Cpanel Branch (plain id); null legacy/unused — scoped per branch
  prefixEnabled Boolean         @default(true)
  prefixValue   String?
  dateFormat    BatchDateFormat @default(YYMMDD)
  paddingLength Int             @default(4)
  startingNo    Int             @default(1)
  renumber      BatchRenumber   @default(DAILY)
  isLocked      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // The next number is derived from the MAX existing batch sequence in the
  // period (see BatchNumberingService), so no stored counter is kept — back-
  // dated / out-of-order entry can't reset or duplicate a sequence.

  @@unique([companyId, branchId])
  @@index([companyId])
  @@map("batch_numbering_rules")
}
