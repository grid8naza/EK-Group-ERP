// Production domain — manufacturing / production orders.
//
// This is the Production module's own domain file. Per the ownership rule in
// schema.prisma, cross-domain references (companyId -> Cpanel Company,
// assignedUserId -> Cpanel User) are PLAIN id columns with NO @relation, so the
// Production tables stay a self-contained unit that can move to its own database
// when this module is extracted into a service.

enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ProductionOrder {
  id             Int              @id @default(autoincrement())
  companyId      Int // -> Cpanel Company, by id (no cross-domain FK)
  orderNo        String
  productName    String
  quantity       Int
  unit           String?
  status         ProductionStatus @default(PLANNED)
  plannedDate    DateTime?
  completedDate  DateTime?
  assignedUserId Int? // -> Cpanel User, by id (no cross-domain FK)
  remarks        String?
  isLocked       Boolean          @default(false) // when locked, must be unlocked before edit/delete
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([companyId, orderNo])
  @@index([companyId])
  @@map("production_orders")
}

/// Lifecycle of a Work Order — a production execution document.
enum WorkOrderStatus {
  PENDING // created from a sales order, awaiting production planning
  IN_PROGRESS // being produced
  COMPLETED // produced and banked to stock
  CANCELLED
}

/// A production Work Order — what the seller must MAKE to fulfil a sales order.
/// Created from an APPROVED ICSO (one per order), covering only the lines that
/// need producing (nothing in stock backs them). Cross-domain ids (companyId ->
/// Company, salesOrderId -> CRM SalesOrder, productId / unitId -> inventory,
/// createdByUserId -> User) are PLAIN ids with no @relation, so Production stays
/// self-contained.
model WorkOrder {
  id              Int             @id @default(autoincrement())
  companyId       Int // -> Cpanel Company (the producing / selling company)
  branchId        Int? // -> Cpanel Branch (optional)
  orderNo         String // WO-#### per company (system-generated)
  // The sales order this fulfils. Unique: an ICSO raises one work order.
  salesOrderId    Int?            @unique // -> CRM SalesOrder (plain id)
  soNumber        String? // snapshot of the source order number
  soDeliveryAt    DateTime? // delivery date the sales order committed to
  status          WorkOrderStatus @default(PENDING)
  notes           String?
  isLocked        Boolean         @default(false)
  createdByUserId Int // -> Cpanel User
  // The production plan that clubbed this order (null = not yet planned).
  productionPlanId Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  lines          WorkOrderLine[]
  productionPlan ProductionPlan?    @relation(fields: [productionPlanId], references: [id], onDelete: SetNull)
  receipt        ProductionReceipt?

  @@unique([companyId, orderNo])
  @@index([companyId, status])
  @@index([productionPlanId])
  @@map("work_orders")
}

/// A Production Receipt — finished goods banked into stock. Recording production
/// against a Work Order creates one receipt: each product becomes a new stock
/// batch (PRODUCTION stock-in) at the store, and the work order is completed.
model ProductionReceipt {
  id              Int      @id @default(autoincrement())
  companyId       Int
  branchId        Int?
  receiptNo       String // PR-#### per company
  workOrderId     Int?     @unique // one receipt per work order
  workOrderNo     String? // snapshot
  storeId         Int? // -> inventory Store the goods were banked into
  storeName       String? // snapshot
  receiptDate     DateTime @default(now())
  notes           String?
  isLocked        Boolean  @default(false)
  createdByUserId Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lines     ProductionReceiptLine[]
  workOrder WorkOrder?              @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@unique([companyId, receiptNo])
  @@index([companyId])
  @@map("production_receipts")
}

/// One produced line: the product, quantity, and the stock batch it became.
model ProductionReceiptLine {
  id          Int    @id @default(autoincrement())
  receiptId   Int
  productId   Int // -> inventory Product (plain id)
  productName String // snapshot
  quantity    Float
  unitId      Int // -> Unit (plain id)
  batchId     Int? // -> inventory StockBatch (the batch this became)
  batchNo     String? // snapshot
  expiryDate  DateTime?

  receipt ProductionReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@map("production_receipt_lines")
}

/// One line of a Work Order — a product to produce and how much.
model WorkOrderLine {
  id          Int   @id @default(autoincrement())
  workOrderId Int
  sequence    Int   @default(0)
  productId   Int // -> inventory Product (plain id)
  quantity    Float
  unitId      Int // -> Unit (plain id)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@map("work_order_lines")
}

/// A production division — an org unit of the manufacturing company that makes a
/// family of products (e.g. Bakery, Pastry, Sweets, Savories). Each PRIMARY
/// (level-1) product group is assigned to a division, so demand can be grouped by
/// division for planning and per-division performance tracing. companyId is a
/// plain cross-domain id.
model ProductionDivision {
  id          Int      @id @default(autoincrement())
  companyId   Int // -> Cpanel Company (the manufacturing company)
  code        String // DIV-### per company (system-generated)
  name        String
  description String?
  isActive    Boolean  @default(true)
  isLocked    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  groups ProductionDivisionGroup[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("production_divisions")
}

/// A Packing operation — turns unpacked products into packed, sellable ones.
/// Each packed line consumes its unpacked source(s) and packing materials from
/// stock and banks the packed product as a new batch. Cross-domain ids are plain.
model Packing {
  id              Int      @id @default(autoincrement())
  companyId       Int
  branchId        Int?
  packingNo       String // PK-#### per company
  storeId         Int? // -> inventory Store (source consumed / packed banked)
  storeName       String? // snapshot
  packingDate     DateTime @default(now())
  notes           String?
  isLocked        Boolean  @default(false)
  createdByUserId Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lines PackingLine[]

  @@unique([companyId, packingNo])
  @@index([companyId])
  @@map("packings")
}

/// One packed product produced by a packing operation, and the batch it became.
model PackingLine {
  id          Int       @id @default(autoincrement())
  packingId   Int
  productId   Int // the packed product (plain id -> inventory Product)
  productName String // snapshot
  quantity    Float
  unitId      Int // -> Unit (plain id)
  batchId     Int? // -> inventory StockBatch (the packed batch)
  batchNo     String? // snapshot
  expiryDate  DateTime?

  packing Packing @relation(fields: [packingId], references: [id], onDelete: Cascade)

  @@index([packingId])
  @@map("packing_lines")
}

/// Lifecycle of a Production Plan.
enum ProductionPlanStatus {
  DRAFT // built from pending work orders, under review
  CONFIRMED // released to the shop floor / material request
  CANCELLED
}

/// A Production Plan clubs the pending Work Orders into one buildable plan:
/// demand aggregated per product, grouped by the producing division, with the
/// raw-material requirement exploded from recipes. Cross-domain ids are plain.
model ProductionPlan {
  id              Int                  @id @default(autoincrement())
  companyId       Int
  branchId        Int?
  planNo          String // PP-#### per company (system-generated)
  planDate        DateTime             @default(now())
  status          ProductionPlanStatus @default(DRAFT)
  notes           String?
  isLocked        Boolean              @default(false)
  createdByUserId Int
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  lines            ProductionPlanLine[]
  materials        ProductionPlanMaterial[]
  workOrders       WorkOrder[]
  materialRequests MaterialRequest[]

  @@unique([companyId, planNo])
  @@index([companyId, status])
  @@map("production_plans")
}

/// Lifecycle of a Material Request (store requisition).
enum MaterialRequestStatus {
  DRAFT // raised from a plan, awaiting store issue
  ISSUED // store has issued the materials to the factory
  CANCELLED
}

/// A Material Request — the requisition operations sends to the store for the
/// raw materials one production division needs. Raised from a Production Plan,
/// one per division, aggregating that division's products' recipe materials.
model MaterialRequest {
  id               Int                   @id @default(autoincrement())
  companyId        Int
  branchId         Int?
  requestNo        String // MR-#### per company
  productionPlanId Int?
  planNo           String? // snapshot
  divisionId       Int? // -> ProductionDivision (null = unassigned products)
  divisionName     String? // snapshot
  storeId          Int? // -> inventory Store the materials are requested from
  storeName        String? // snapshot
  status           MaterialRequestStatus @default(DRAFT)
  // The goods issue that fulfilled it: the GIN number the stock-out ledger rows
  // carry, and when the store handed the materials over.
  issueNo          String?
  issuedAt         DateTime?
  notes            String?
  isLocked         Boolean               @default(false)
  createdByUserId  Int
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  lines MaterialRequestLine[]
  plan  ProductionPlan?       @relation(fields: [productionPlanId], references: [id], onDelete: SetNull)

  @@unique([companyId, requestNo])
  @@index([companyId, status])
  @@index([productionPlanId])
  @@map("material_requests")
}

/// One requested raw-material line: how much is needed and how much the store
/// had on hand when the request was raised (snapshot, for the shortfall).
model MaterialRequestLine {
  id           Int    @id @default(autoincrement())
  requestId    Int
  itemId       Int // -> inventory Item (plain id)
  itemName     String // snapshot
  requiredQty  Float
  availableQty Float  @default(0) // on-hand at the store when raised (snapshot)
  // What the store actually handed over. May be LESS than required (a short
  // issue); only this quantity leaves stock.
  issuedQty    Float  @default(0)
  unitId       Int // -> Unit (plain id)

  request MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("material_request_lines")
}

/// One planned product line: aggregated demand across the clubbed work orders,
/// tagged with the division that will make it (resolved from its primary group
/// at build time and snapshotted).
model ProductionPlanLine {
  id             Int    @id @default(autoincrement())
  planId         Int
  productId      Int // -> inventory Product (plain id)
  productName    String // snapshot
  quantity       Float // aggregated demand
  unitId         Int // -> Unit (plain id)
  primaryGroupId Int? // -> inventory Group (level 1), resolved at build
  divisionId     Int? // -> ProductionDivision (null = unassigned)
  divisionName   String? // snapshot

  plan ProductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("production_plan_lines")
}

/// One raw-material requirement line: the item quantity needed across the whole
/// plan, exploded from product recipes and aggregated. Feeds the Material Request.
model ProductionPlanMaterial {
  id       Int    @id @default(autoincrement())
  planId   Int
  itemId   Int // -> inventory Item (plain id)
  itemName String // snapshot
  quantity Float
  unitId   Int // -> Unit (plain id)

  plan ProductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("production_plan_materials")
}

/// Assigns a PRIMARY (level-1) product group to a production division.
/// primaryGroupId is a plain cross-domain id (-> inventory Group). Unique per
/// company, so a primary group is produced by exactly one division. companyId is
/// denormalized from the division to scope that uniqueness.
model ProductionDivisionGroup {
  id                   Int @id @default(autoincrement())
  companyId            Int // denormalized from the division for per-company uniqueness
  productionDivisionId Int
  primaryGroupId       Int // -> inventory Group (level 1), plain id

  division ProductionDivision @relation(fields: [productionDivisionId], references: [id], onDelete: Cascade)

  @@unique([companyId, primaryGroupId])
  @@index([productionDivisionId])
  @@map("production_division_groups")
}
