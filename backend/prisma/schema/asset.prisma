// Asset domain — Asset Category and Asset Group masters. Mirrors the Inventory
// Category/Group masters (multi-company availability, system-generated positional
// hierarchy codes, multilayer groups) but is a fully independent set of tables
// and carries no Item/Product applicability (assets are flat in that sense).
//
// Cross-domain rule: company links are plain `companyId` columns (no @relation to
// the Cpanel Company); every real @relation stays inside this domain file.

/// Operational availability of a machine. Replaces the old isActive boolean so a
/// machine that is temporarily out of service (maintenance) is distinct from one
/// that is retired.
enum AssetStatus {
  ACTIVE
  INACTIVE
  UNDER_REPAIR
}

/// Lifecycle of a production-line booking (a machine time-slot reserved while
/// planning production). Bookings are created/updated from the Production module.
enum AssetBookingStatus {
  PLANNED
  CONFIRMED
  COMPLETED
  CANCELLED
}

/// Asset Category master — top level of the asset classification. Available to
/// all companies or a chosen set (via AssetCategoryCompany links). Code is a
/// system-generated 2-digit category segment.
model AssetCategory {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  description  String?
  allCompanies Boolean  @default(false) // true = available to every company
  isActive     Boolean  @default(true)
  isLocked     Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companies AssetCategoryCompany[]
  groups    AssetGroup[]
  assets    Asset[]

  @@map("asset_categories")
}

/// Links an asset category to a company it is available in (when not
/// `allCompanies`). companyId is a plain id → Cpanel Company (no cross-domain FK).
model AssetCategoryCompany {
  id         Int @id @default(autoincrement())
  categoryId Int
  companyId  Int // -> Cpanel Company, by id (no cross-domain FK)

  category AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, companyId])
  @@index([companyId])
  @@map("asset_category_companies")
}

/// Asset Group master — a multilayer sub-level under an Asset Category (≤5
/// levels), with system-generated positional codes. A "primary" group has no
/// parent (level 1); a sub-group's parent is another group in the SAME category
/// whose `subGroupApplicable` is true. Deleting a category is blocked while it
/// still has groups (Restrict).
model AssetGroup {
  id                 Int     @id @default(autoincrement())
  categoryId         Int
  parentGroupId      Int?
  level              Int     @default(1) // 1 = primary group … up to 5
  subGroupApplicable Boolean @default(false) // true = container: holds sub-groups
  code               String  @unique // system-generated positional hierarchy code
  name               String
  description        String?
  allCompanies       Boolean @default(false) // true = available to every company
  isActive           Boolean @default(true)
  isLocked           Boolean @default(false) // when locked, must be unlocked before edit/delete
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  category  AssetCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  parent    AssetGroup?        @relation("AssetGroupHierarchy", fields: [parentGroupId], references: [id], onDelete: Restrict)
  children  AssetGroup[]       @relation("AssetGroupHierarchy")
  companies AssetGroupCompany[]
  assets    Asset[]

  @@index([categoryId])
  @@index([parentGroupId])
  @@map("asset_groups")
}

/// Links an asset group to a company it is available in (when not `allCompanies`).
model AssetGroupCompany {
  id        Int @id @default(autoincrement())
  groupId   Int
  companyId Int // -> Cpanel Company, by id (no cross-domain FK)

  group AssetGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, companyId])
  @@index([companyId])
  @@map("asset_group_companies")
}

/// Asset Master — an individual asset (e.g. a machine), classified under a leaf
/// Asset Group (whose parent chain gives the Group/Category). Its code is a
/// system-generated positional code under that leaf group. Unit references
/// (`capacityUnitId`, `perUnitId`) point to the global Unit master by plain id
/// (cross-domain rule: no @relation). Availability mirrors the other masters.
model Asset {
  id             Int       @id @default(autoincrement())
  code           String    @unique // system-generated (leaf-group positional code)
  categoryId     Int
  groupId        Int // leaf asset group this asset belongs to
  name           String // Machine Name
  minCapacity    Float     @default(0)
  maxCapacity    Float     @default(0)
  capacityUnitId Int? // -> Unit (plain id, no cross-domain FK): Cuts, Pieces, Litre…
  perUnitId      Int? // -> Unit (plain id): the "per" basis (Minutes, Hour…)
  brand          String?
  model          String?
  serialNumber   String?
  lifeSpanYears  Int       @default(0)
  purchasedFrom  String?
  purchaseDate   DateTime?
  purchasePrice  Float     @default(0)
  warrantyPeriod String? // free text (e.g. "12 months", "2 years")
  allCompanies   Boolean     @default(false)
  status         AssetStatus @default(ACTIVE)
  // Machines flagged here can be reserved (prebooked) when planning production.
  isProductionLine Boolean   @default(false)
  // Running cost per hour of this machine; feeds the equipment cost in a recipe's
  // process flow. Only meaningful for production-line machines.
  costPerHour    Float       @default(0)
  isLocked       Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  category  AssetCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  group     AssetGroup     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  companies AssetCompany[]
  bookings  AssetBooking[]

  @@index([categoryId])
  @@index([groupId])
  @@map("assets")
}

/// A production-line booking: a machine reserved for a product/batch over a time
/// slot on a given day. Rows are created/updated when planning production in the
/// Production module. `productId` points to the Inventory Product master by plain
/// id (cross-domain: no @relation); `productName` is a snapshot for display.
model AssetBooking {
  id          Int                @id @default(autoincrement())
  assetId     Int
  productId   Int? // -> Inventory Product (plain id, no cross-domain FK)
  productName String // snapshot of the product name at booking time
  batchNo     String?
  date        DateTime // the booking day (time carried by timeFrom/timeTo)
  timeFrom    String // "HH:mm"
  timeTo      String // "HH:mm"
  status      AssetBookingStatus @default(PLANNED)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([date])
  @@map("asset_bookings")
}

/// Links an asset to a company it is available in (when not `allCompanies`).
model AssetCompany {
  id        Int @id @default(autoincrement())
  assetId   Int
  companyId Int // -> Cpanel Company, by id (no cross-domain FK)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, companyId])
  @@index([companyId])
  @@map("asset_companies")
}
