// Accounts domain — finance & procurement master data.
//
// Own domain file. Per the schema-ownership rule, any cross-domain reference
// (e.g. companyId -> Cpanel Company) is a PLAIN id column with NO @relation.

/// Supplier master (per company). A vendor goods are purchased from; referenced
/// by Goods Receipt Notes (Inventory) via a plain cross-domain id. `code` is
/// system-generated (SUP-#### per company).
model Supplier {
  id            Int      @id @default(autoincrement())
  companyId     Int // -> Cpanel Company (plain id)
  code          String // SUP-#### per company (system-generated)
  name          String
  contactPerson String?
  phone         String?
  email         String?
  gstNumber     String? // GSTIN
  address       String?
  /// Days from a bill's date until it falls due — what an ageing report counts
  /// against. Null = no agreed term, so a bill is due the day it is raised.
  creditDays    Int?
  /// The most that may stand unpaid at once. Null = no ceiling agreed.
  creditLimit   Decimal? @db.Decimal(18, 2)
  isActive      Boolean  @default(true)
  isLocked      Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@map("suppliers")
}

/// Who the company sells to — the other half of the party masters, and what
/// details a receivable control account (Sundry Debtors) down to a name.
///
/// Deliberately the mirror of Supplier: the two are the same kind of thing seen
/// from opposite sides, and a party master that differed by side would make the
/// statement and ageing reports two pieces of work instead of one.
model Customer {
  id            Int      @id @default(autoincrement())
  companyId     Int // -> Cpanel Company (plain id)
  code          String // CUS-#### per company (system-generated)
  name          String
  contactPerson String?
  phone         String?
  email         String?
  gstNumber     String? // GSTIN
  address       String?
  /// Days from a bill's date until it falls due — what an ageing report counts
  /// against. Null = no agreed term, so a bill is due the day it is raised.
  creditDays    Int?
  /// The most that may stand unpaid at once. Null = no ceiling agreed.
  creditLimit   Decimal? @db.Decimal(18, 2)
  isActive      Boolean  @default(true)
  isLocked      Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@map("customers")
}

// -----------------------------------------------------------------------------
// Chart of Accounts — Annexure D to the SRS.
//
// The account master is a GROUP-LEVEL master: one Chart of Accounts shared by
// every company, with per-company adoption recorded separately. That is what
// makes consolidation map one-to-one, and it is why AccountGroup and Account
// carry no companyId while AccountCompany does.
//
// The annexure ships this as its own `acct` PostgreSQL schema with UUID keys and
// Row-Level Security. It is modelled here in Prisma instead, keeping every code,
// flag and rule but using this ERP's own tenant model (Int ids, one public
// schema, company scoping by X-Company-Id) so there is a single notion of a
// company rather than two to keep in step.
// -----------------------------------------------------------------------------

enum AccountNature {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

/// Which side a balance sits on when it is normal rather than unusual.
enum BalanceSide {
  DR
  CR
}

/// Balance Sheet or Profit and Loss. Fixed by nature — see the check on both
/// AccountGroup and Account in the annexure (D.4, D.5).
enum StatementType {
  BS
  PL
}

// The annexure's own cost-centre rule per account (Mandatory / Optional / n/a,
// D.5) is deliberately NOT a column here. This ERP asks the two plainer
// questions the finance team wants at data entry — does a line to this account
// carry a cost centre, and does it carry a cost object — and the seed derives
// their starting position from the annexure's rule, which stays recorded in
// `coa-data.ts`. See Account.hasCostCenter.

/// The second level of the chart: the schedule a block of accounts is reported
/// under, between its primary group (asset, liability, income, expense) and the
/// block itself.
///
/// Not from the annexure, which stops at the block — this is the tier the
/// statements are actually read in. It is a classification rather than a group
/// row because the five-digit numbering (D.3) has no room above 10000: a parent
/// of both 10000 and 11000 could share two digits with neither.
enum MainGroup {
  NON_CURRENT_ASSET
  CURRENT_ASSET
  EQUITY_AND_RESERVES
  NON_CURRENT_LIABILITY
  CURRENT_LIABILITY
  DIRECT_INCOME
  INDIRECT_INCOME
  PURCHASE
  DIRECT_EXPENSE
  INDIRECT_EXPENSE
}

/// What a voucher IS — the kind of transaction it records (Annexure D.11).
enum VoucherNature {
  JOURNAL
  PAYMENT
  RECEIPT
  CONTRA
  SALES
  PURCHASE
  CREDIT_NOTE
  DEBIT_NOTE
  PAYROLL
  DEPRECIATION
  INTERCOMPANY
  MESS
  GST_SETOFF
  OPENING
}

/// A voucher is written, then posted, and thereafter only cancelled. There is
/// no fourth state: a posted voucher is never edited and never deleted, because
/// the books have to say what they said (D.12).
enum VoucherStatus {
  DRAFT
  POSTED
  CANCELLED
}

/// The sub-ledger a control account is aged by.
enum PartyKind {
  SUPPLIER
  CUSTOMER
  EMPLOYEE
  COMPANY
  OTHER
}

/// The group hierarchy the ledger accounts hang from. A code ending in 00 is a
/// group. Groups are HEADINGS, never posted to — nothing in the ledger will ever
/// reference this table, which is what keeps the trial balance flat and the
/// balance-sheet roll-up unambiguous.
model AccountGroup {
  id            Int           @id @default(autoincrement())
  code          String        @unique // 10000, 10100, …
  name          String
  parentGroupId Int?
  nature        AccountNature
  normalSide    BalanceSide
  statement     StatementType
  /// Which schedule this block reports under. Carried by TOP-LEVEL groups only;
  /// a sub-group reports under whatever its parent does, so storing it on both
  /// would only create two answers to one question.
  mainGroup     MainGroup?
  /// The Tally primary group this corresponds to — the migration key for the
  /// books the finance team keeps today.
  tallyGroup    String?
  sortOrder     Int           @default(0)
  /// Shipped by the annexure. May be renamed or deactivated, never deleted.
  isSystem      Boolean       @default(false)
  isActive      Boolean       @default(true)
  isLocked      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  parent   AccountGroup?  @relation("AccountGroupTree", fields: [parentGroupId], references: [id], onDelete: Restrict)
  children AccountGroup[] @relation("AccountGroupTree")
  accounts Account[]

  @@index([parentGroupId])
  @@map("account_groups")
}

/// The group-level master Chart of Accounts. Shared by all companies; which of
/// them may post to a given account is in AccountCompany.
model Account {
  id         Int           @id @default(autoincrement())
  code       String        @unique // five digits, per D.3
  name       String
  groupId    Int
  nature     AccountNature
  normalSide BalanceSide
  statement  StatementType
  tallyGroup String?

  /// Offsets the group it sits in rather than forming a block of its own — e.g.
  /// accumulated depreciation under Fixed Assets, mess recovery under Mess
  /// Expenses. Each nets against its own parent in the statements.
  isContra     Boolean    @default(false)
  /// Balance is detailed by a party sub-ledger; a posting without a party would
  /// put the control account out of step with the sub-ledger, so it is rejected.
  isControl    Boolean    @default(false)
  controlParty PartyKind?

  /// Does a voucher line on this account carry a cost centre? Checked, the
  /// entry screen asks for one and will not post the line without it; cleared,
  /// it never asks and the line's costCenterId stays null. Company and branch
  /// are asked for on every entry regardless — they are not analysis
  /// dimensions but the tenant the entry belongs to.
  ///
  /// This is the SECOND of two checkpoints. The first is the company's own
  /// setup (Company.costCenterApplicable / costObjectApplicable /
  /// branchApplicable): a company that does not work in cost centres has none
  /// to name, so nothing is asked for however this is set. Both are resolved
  /// together, and only there — src/common/entry-rules.ts.
  hasCostCenter Boolean @default(false)
  /// The same for the cost object — the department under the centre. A
  /// department cannot be named without its division, so ticking this ticks
  /// hasCostCenter with it.
  hasCostObject Boolean @default(false)

  isGstRelevant   Boolean @default(false)
  isBankOrCash    Boolean @default(false)
  isReconcilable  Boolean @default(false)
  /// Eliminated on consolidation, against the account named by eliminationPair.
  isIntercompany  Boolean @default(false)
  /// Code of the mirror account — a code rather than an id so the seed can be
  /// loaded in any order and re-run without a second pass.
  eliminationPair String?
  /// System-only accounts refuse a hand-written journal.
  allowManualJe   Boolean @default(true)
  /// Shipped by the annexure and not deletable.
  isSystem        Boolean @default(false)
  notes           String?

  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// NULL = a group master account available to every company. Set = a private
  /// account created by one company; it still carries a globally unique code so
  /// consolidation never collides.
  ownerCompanyId Int? // -> Cpanel Company (plain id)

  group        AccountGroup     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  companies    AccountCompany[]
  voucherLines VoucherLine[]

  @@index([groupId])
  @@index([isActive])
  @@map("accounts")
}

/// Which company has adopted which account. A company posts only to the accounts
/// it has adopted, so the trading company never sees a production account and the
/// factory never sees a cafe sales account.
model AccountCompany {
  id           Int          @id @default(autoincrement())
  companyId    Int // -> Cpanel Company (plain id)
  accountId    Int
  /// Optional company-specific label; the master name shows when unset.
  localName    String?
  allowPosting Boolean      @default(true)
  openingSide  BalanceSide?
  isActive     Boolean      @default(true)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([companyId, accountId])
  @@index([companyId, isActive])
  @@map("account_companies")
}

/// The kinds of thing the annexure analyses cost by — branch, department,
/// kitchen, cafe, counter, mess, vehicle, project (D.7). Global, like the
/// account master.
///
/// The centres THEMSELVES are not modelled here: `CostCenter` in the Cpanel
/// domain already owns them, per company, with `CostObject` beneath — and
/// product costing, the stock ledger and production plans all reference it
/// already. A second table would have split the same idea in two.
///
/// This ERP's shape is two fixed levels rather than the annexure's open tree:
/// the CENTRE is the company's function — Operations, Admin Support — and the
/// OBJECT beneath it is the department. So the classification hangs off the
/// COST OBJECT, via a plain `categoryCode` (no relation — the cross-domain
/// rule), which is what still makes the annexure's cost-per-meal,
/// per-counter and per-vehicle analysis possible without one account per
/// outlet. BRANCH is not among the kinds used: every entry carries its branch
/// in its own right.
model CostCentreCategory {
  code        String  @id // BRANCH, DEPT, KITCHEN, …
  name        String
  description String?
  /// The annexure's own flag (only BRANCH). Not read here — branch is carried
  /// on the entry itself, and what a line must name is decided per account by
  /// Account.hasCostCenter / hasCostObject.
  isMandatory Boolean @default(false)
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  @@map("cost_centre_categories")
}

// -----------------------------------------------------------------------------
// The general ledger — Annexure D.11.
//
// Amounts here are DECIMAL, not Float, which is the one place this schema
// departs from the rest of the ERP on purpose: the annexure forbids
// floating-point in the accounting schema (D.10), and a voucher that must
// balance exactly is precisely where 0.1 + 0.2 stops being 0.3.
//
// company, branch, date and status are carried on the LINE as well as the
// header, so a ledger or trial-balance query never has to join upward.
// -----------------------------------------------------------------------------

/// The kinds of voucher the books recognise. Seeded; a company may deactivate
/// one it does not use but the set itself is not user data — the posting map
/// (D.9) names these.
model VoucherType {
  id     Int           @id @default(autoincrement())
  code   String        @unique // JOURNAL, PAYMENT, …
  name   String
  nature VoucherNature
  /// Written by a module (a sale, a payroll run), never by hand — kept out of
  /// the manual entry screen so nobody writes a sales voucher beside the
  /// invoice that should have raised it.
  isSystemOnly Boolean @default(false)
  /// The Document Master code its numbering rule is keyed on, so each kind has
  /// its own series and its own configurable prefix.
  documentCode String
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)

  vouchers Voucher[]

  @@map("voucher_types")
}

/// A voucher header. One per transaction; the money is on its lines.
model Voucher {
  id            Int      @id @default(autoincrement())
  companyId     Int // -> Cpanel Company (plain id)
  branchId      Int? // -> Cpanel Branch (plain id)
  voucherTypeId Int
  voucherNo     String
  date          DateTime
  narration     String?

  /// WHAT the transaction was, over and above which kind of voucher recorded it.
  /// The voucher type says a sale was made; these say it was a B2C sale rather
  /// than an intercompany one — the distinction the statements are cut by and
  /// the one GST turns on. Both -> Cpanel LookupValue (TRANSACTION_TYPE /
  /// TRANSACTION_SUBTYPE); the subtype's parentValueId is the type.
  transactionTypeId    Int?
  transactionSubtypeId Int?

  status VoucherStatus @default(DRAFT)
  /// Running totals, kept on the header so a listing needs no aggregate. They
  /// are equal on every POSTED voucher — that is what posting checks.
  totalDebit  Decimal @default(0) @db.Decimal(18, 2)
  totalCredit Decimal @default(0) @db.Decimal(18, 2)

  /// Where a machine-written voucher came from, so a posting can be traced back
  /// to the invoice or payroll run that raised it (and posted only once).
  sourceModule  String?
  sourceDocType String?
  sourceDocId   Int?

  /// The voucher this one reverses — a correction is a reversal, never an edit.
  reversesVoucherId Int?
  cancelReason      String?

  createdByUserId Int?
  postedByUserId  Int?
  postedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  type  VoucherType   @relation(fields: [voucherTypeId], references: [id], onDelete: Restrict)
  lines VoucherLine[]

  /// One number per kind per company. Numbers are derived (MAX + 1), so the
  /// constraint is what makes a race loud rather than silent.
  @@unique([companyId, voucherTypeId, voucherNo])
  @@index([companyId, date])
  @@index([companyId, status])
  @@index([sourceModule, sourceDocType, sourceDocId])
  @@map("vouchers")
}

/// The general ledger itself: one row per debit or credit.
model VoucherLine {
  id        Int @id @default(autoincrement())
  voucherId Int
  sequence  Int @default(0)

  companyId Int
  branchId  Int?
  accountId Int
  /// Named only where the account asks for one — see Account.hasCostCenter and
  /// src/common/entry-rules.ts, which decides that from the company's setup and
  /// the account's own rule together.
  costCenterId Int? // -> Cpanel CostCenter (plain id)
  costObjectId Int? // -> Cpanel CostObject (plain id)

  /// A line carries either a debit or a credit, never both and never neither.
  debit     Decimal @default(0) @db.Decimal(18, 2)
  credit    Decimal @default(0) @db.Decimal(18, 2)
  narration String?
  /// Inherited from the header unless this line says otherwise — one voucher may
  /// carry both a B2B and a B2C line. Denormalised like companyId/date/status
  /// above it, for the same reason: a statement cut by transaction type reads
  /// this table alone and never joins up to the header.
  transactionTypeId    Int?
  transactionSubtypeId Int?

  /// WHOSE balance this line moves, where the account is a control account.
  /// Sundry Creditors is a total; this is the supplier it is a total OF, and
  /// without it a party statement cannot be produced at all.
  ///
  /// Kind + id rather than one nullable column per master: the party may be a
  /// supplier, a customer or (once HR builds it) an employee, and a column each
  /// would leave three nulls on every line to say one thing. Required exactly
  /// when Account.isControl, and the kind must match Account.controlParty —
  /// enforced in VoucherService, since no FK can express "one of three tables".
  partyKind PartyKind?
  partyId   Int?

  /// Denormalized from the header so the ledger reads without a join.
  date   DateTime
  status VoucherStatus @default(DRAFT)

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([voucherId])
  @@index([companyId, accountId, date])
  // Statements cut by what the transaction WAS (B2B vs B2C vs intercompany).
  @@index([companyId, transactionTypeId, date])
  // A party's statement of account, and its ageing: every line for one party,
  // in date order.
  @@index([companyId, partyKind, partyId, date])
  @@index([companyId, costCenterId, date])
  @@map("voucher_lines")
}
