// HR domain — Manpower classification masters: Category → Group → Designation.
// Mirrors the Asset domain (multi-company availability, system-generated
// positional hierarchy codes, multilayer groups) but the leaf carries a
// `ratePerHour` (used for manpower cost in a recipe's process flow) instead of
// asset-specific fields. Category/Group/Designation are also intended to feed a
// future Employee Master as lookups.
//
// Cross-domain rule: company links are plain `companyId` columns (no @relation to
// the Cpanel Company); every real @relation stays inside this domain file.

/// Manpower Category master — top level of the manpower classification (e.g.
/// Staff, Workers). Available to all companies or a chosen set (via
/// HrCategoryCompany links). Code is a system-generated 2-digit category segment.
model HrCategory {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  description  String?
  allCompanies Boolean  @default(false) // true = available to every company
  isActive     Boolean  @default(true)
  isLocked     Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companies    HrCategoryCompany[]
  groups       HrGroup[]
  designations HrDesignation[]

  @@map("hr_categories")
}

/// Links an HR category to a company it is available in (when not
/// `allCompanies`). companyId is a plain id → Cpanel Company (no cross-domain FK).
model HrCategoryCompany {
  id         Int @id @default(autoincrement())
  categoryId Int
  companyId  Int // -> Cpanel Company, by id (no cross-domain FK)

  category HrCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, companyId])
  @@index([companyId])
  @@map("hr_category_companies")
}

/// Manpower Group master — a multilayer sub-level under an HR Category (≤5
/// levels, e.g. Skilled Worker / Unskilled Worker), with system-generated
/// positional codes. A "primary" group has no parent (level 1); a sub-group's
/// parent is another group in the SAME category whose `subGroupApplicable` is
/// true. Deleting a category is blocked while it still has groups (Restrict).
model HrGroup {
  id                 Int      @id @default(autoincrement())
  categoryId         Int
  parentGroupId      Int?
  level              Int      @default(1) // 1 = primary group … up to 5
  subGroupApplicable Boolean  @default(false) // true = container: holds sub-groups
  code               String   @unique // system-generated positional hierarchy code
  name               String
  description        String?
  allCompanies       Boolean  @default(false) // true = available to every company
  isActive           Boolean  @default(true)
  isLocked           Boolean  @default(false) // when locked, must be unlocked before edit/delete
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  category     HrCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  parent       HrGroup?         @relation("HrGroupHierarchy", fields: [parentGroupId], references: [id], onDelete: Restrict)
  children     HrGroup[]        @relation("HrGroupHierarchy")
  companies    HrGroupCompany[]
  designations HrDesignation[]

  @@index([categoryId])
  @@index([parentGroupId])
  @@map("hr_groups")
}

/// Links an HR group to a company it is available in (when not `allCompanies`).
model HrGroupCompany {
  id        Int @id @default(autoincrement())
  groupId   Int
  companyId Int // -> Cpanel Company, by id (no cross-domain FK)

  group HrGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, companyId])
  @@index([companyId])
  @@map("hr_group_companies")
}

/// Designation Master — an individual worker designation (e.g. Skilled Baker,
/// Helper), classified under a leaf HR Group (whose parent chain gives the
/// Group/Category). Its code is a system-generated positional code under that
/// leaf group. `ratePerHour` is the manpower cost rate used in recipe process
/// costing. Availability mirrors the other masters.
model HrDesignation {
  id           Int      @id @default(autoincrement())
  code         String   @unique // system-generated (leaf-group positional code)
  categoryId   Int
  groupId      Int // leaf HR group this designation belongs to
  name         String
  description  String?
  // Manpower cost rate per hour; feeds the manpower cost in a recipe's process flow.
  ratePerHour  Float    @default(0)
  allCompanies Boolean  @default(false)
  isActive     Boolean  @default(true)
  isLocked     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category  HrCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  group     HrGroup                @relation(fields: [groupId], references: [id], onDelete: Restrict)
  companies HrDesignationCompany[]
  employees Employee[]
  postings  EmployeePosting[]

  @@index([categoryId])
  @@index([groupId])
  @@map("hr_designations")
}

/// Links a designation to a company it is available in (when not `allCompanies`).
model HrDesignationCompany {
  id            Int @id @default(autoincrement())
  designationId Int
  companyId     Int // -> Cpanel Company, by id (no cross-domain FK)

  designation HrDesignation @relation(fields: [designationId], references: [id], onDelete: Cascade)

  @@unique([designationId, companyId])
  @@index([companyId])
  @@map("hr_designation_companies")
}

// ---------------------------------------------------------------- employees --

/// As recorded on the employee's own documents. OTHER is present because the
/// alternative is refusing to record somebody who exists.
enum EmployeeSex {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  WIDOWED
  DIVORCED
}

/// One person on the payroll (SRS §8.9, FR-HRP-01).
///
/// "including staff who do not have user logins" is the load-bearing half of
/// that requirement: an Employee is NOT a User. Most of the bakery's staff never
/// sign in — their managers mark their attendance and raise their leave — so
/// this row stands on its own and carries no userId. The day somebody is given a
/// login, that is a User row beside this one, not a replacement for it.
///
/// Cross-domain rule: company, branch, division and department are plain `Int`
/// ids with NO @relation. The designation IS a real relation — it lives in this
/// same domain file.
model Employee {
  id   Int    @id @default(autoincrement())
  /// EMP-0001, per company. MAX+1 over what exists rather than a stored counter
  /// (the house rule for every number in the system). Unique WITHIN the company
  /// (see @@unique below) and not across the group: each company numbers its own
  /// people from one, which is what a payroll clerk expects and what stops two
  /// companies fighting over EMP-0001.
  code String
  name String

  // ---- the person ----
  dateOfBirth           DateTime?
  sex                   EmployeeSex?
  maritalStatus         MaritalStatus?
  /// Unique across the group when given: one Aadhaar is one person, so this is
  /// what stops the same employee being entered twice at two branches. Nullable,
  /// because a record should never be blocked for want of a document — Postgres
  /// allows many NULLs under a unique index.
  aadhaarNumber         String?        @unique
  /// Where they are FROM. Labelled "Permanent Address" on the form; the column
  /// keeps its original name so nothing already written has to move.
  address               String?
  /// Where they are living NOW — the one a letter actually reaches, and often
  /// not the same as the permanent one for staff who have moved for the job.
  presentAddress        String?
  phone                 String?
  email                 String?
  /// A BLOOD_GROUP LookupValue id (A+, O-, and the rest), maintained in
  /// HR → Lookups beside education, skills and languages. A plain Int for the
  /// cross-domain reason those carry — LookupValue is a Cpanel table.
  bloodGroupId          Int?
  /// Who to ring, and on what number, when something happens at work.
  emergencyContactName  String?
  emergencyContactPhone String?
  /// Optional. A photograph is wanted on every record and is often not to hand
  /// the day somebody joins — refusing to enrol them until it is would only
  /// mean the record is kept somewhere else in the meantime.
  photoUrl              String?

  /// What they have studied, what they can do, and what they speak.
  ///
  /// Lists of LookupValue ids (EDUCATION / SKILL / LANGUAGE, maintained in
  /// HR → Lookups), held as plain Int arrays: LookupValue is a Cpanel table and
  /// a foreign key across that line is what the cross-domain rule forbids, so
  /// the service checks each id against the right lookup instead.
  ///
  /// Arrays rather than three join tables because nothing is ever hung off the
  /// pairing — no "since when", no proficiency. The day one of them grows a
  /// column of its own it becomes a table; today it would be three tables to
  /// say what three columns say.
  educationIds Int[]
  skillIds     Int[]
  languageIds  Int[]

  // ---- the job ----
  companyId          Int
  branchId           Int? // null = the company as a whole (head office, roving staff)
  /// Division and department, taken from the COMPANY'S OWN structure: a
  /// division is a Cpanel CostCenter, a department the CostObject under it.
  ///
  /// They were briefly a lookup of their own, which was the wrong answer — the
  /// company master already carries this structure, and the ledger already
  /// posts against it. Naming the same department twice would have meant an
  /// employee filed under one "Packing" and their cost posted to another.
  ///
  /// Plain ids with no @relation (the cross-domain rule); the service checks
  /// the centre belongs to the company and the object to the centre. Both
  /// optional: a company that does not work in cost centres still has staff.
  costCenterId       Int?
  costObjectId       Int?
  /// What they are. The CATEGORY and GROUP are not stored here — a designation
  /// already knows both, and a second copy is a second thing to keep in step.
  /// The form still asks for all three, because that is how a person finds the
  /// designation; only the answer is stored.
  designationId      Int
  /// Their grade — an EMPLOYEE_GRADE LookupValue (A…E out of the box, editable
  /// in HR → Lookups). A plain Int for the cross-domain reason above.
  ///
  /// Beside the designation rather than derived from it: two people can hold
  /// the same designation on different grades, which is the whole point of
  /// having one.
  gradeId            Int?
  /// How they are engaged — an EMPLOYEE_TYPE LookupValue (Permanent, Part Time,
  /// Temporary out of the box). Beside the designation, because the same job
  /// can be held on different terms.
  employeeTypeId     Int?
  /// Where they stand with the company today — an EMPLOYEE_STATUS LookupValue
  /// (On Probation, In Service, On Leave, Resigned, Terminated).
  ///
  /// Entered rather than derived, and so NOT the same thing as `isActive` or as
  /// a missing `dateOfConfirmation`. Those are facts about the record; this is
  /// what HR say the position is, and it is the one a manager and a payroll run
  /// have to agree on.
  statusId           Int?
  /// The last day they actually worked — asked for ONLY where the status says
  /// they have gone (Resigned or Terminated), and cleared by the service the
  /// moment it says otherwise.
  ///
  /// Separate from `isActive`, which is whether the record is live, and from
  /// the status itself, which is why they went. This is when.
  lastWorkingDay     DateTime?
  dateOfJoin         DateTime
  /// How long they are on probation, in months. Null = none agreed.
  probationMonths    Int?
  /// When they were actually confirmed. Kept beside the period rather than
  /// worked out from it: the period is what was agreed, this is what happened,
  /// and confirmations run early and late.
  dateOfConfirmation DateTime?
  /// Their manager — another employee, so the line of report is answerable to
  /// somebody who exists. SetNull rather than cascade: when a manager leaves,
  /// their reports stay employed.
  reportsToId        Int?
  /// Whether this person is drawn on the organisation chart. On by default —
  /// the chart is of the whole staff — with an off switch for the records that
  /// would clutter it rather than explain it.
  showInOrgChart     Boolean   @default(true)
  /// The hours THIS person works, where they are not the branch's — minutes
  /// after local midnight, as in AttendanceSetting. Null = whatever the branch
  /// keeps, which is the usual answer.
  ///
  /// Here rather than in a roster because the exception is the person, not the
  /// day: the baker who starts at four starts at four every morning. A genuine
  /// rota, where the same person works mornings one week and nights the next,
  /// is a shift master and is not this.
  defaultTimeIn      Int?
  defaultTimeOut     Int?

  isActive  Boolean  @default(true)
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  designation    HrDesignation           @relation(fields: [designationId], references: [id], onDelete: Restrict)
  reportsTo      Employee?               @relation("EmployeeReportsTo", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports        Employee[]              @relation("EmployeeReportsTo")
  salaryPackages EmployeeSalaryPackage[]
  postings       EmployeePosting[]
  attendance     AttendanceEntry[]
  shifts         EmployeeShiftAssignment[]

  @@unique([companyId, code])
  @@index([companyId, branchId])
  @@index([designationId])
  @@index([reportsToId])
  @@map("employees")
}

/// Whether a salary component is paid ON TOP of the basic or taken OUT of it.
enum SalaryComponentKind {
  ALLOWANCE
  DEDUCTION
}

/// What one employee is paid, from a date.
///
/// A package is never edited into a raise. An increment is a NEW package with a
/// later `effectiveFrom`, and the row it supersedes keeps its own figures for
/// ever — which is what lets a payslip re-run for March next year still come out
/// at March's salary. The series IS the history.
///
/// Payroll asks "what was in force on this date" rather than "what is current":
/// the package whose period contains the day being paid for. That is why the
/// period is stored rather than a flag, and why the periods may not overlap.
model EmployeeSalaryPackage {
  id         Int @id @default(autoincrement())
  employeeId Int

  /// The day this package starts paying. Required — a package with no start
  /// cannot be selected by a payroll run, which is the only thing packages are
  /// for.
  effectiveFrom DateTime
  /// The last day it applies. NULL means "until further notice", which is what
  /// the newest package almost always is; raising an increment closes the one
  /// before it the day before the new one starts.
  effectiveTo   DateTime?

  /// The figure everything else is quoted against. Decimal, not Float: this is
  /// money, and the accounts domain settled on Decimal(18,2) for the same
  /// reason.
  basicSalary Decimal @db.Decimal(18, 2)

  /// Why this package exists — "annual increment", "promoted to Supervisor".
  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee   Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  components EmployeeSalaryComponent[]

  /// Two packages starting the same day would leave payroll with a coin to
  /// toss. The service checks the whole period for overlap; this catches the
  /// exact collision at the database.
  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
  @@map("employee_salary_packages")
}

/// One line of a package: an allowance paid or a deduction taken.
///
/// A ROW per component rather than a column per component, because the list is
/// the business's to maintain (HR → Lookups, SALARY_ALLOWANCE and
/// SALARY_DEDUCTION) — a new allowance must not need a migration. Reports pivot
/// these rows back into a column each, which is the shape a payroll sheet wants.
model EmployeeSalaryComponent {
  id          Int                 @id @default(autoincrement())
  packageId   Int
  kind        SalaryComponentKind
  /// A SALARY_ALLOWANCE or SALARY_DEDUCTION LookupValue id — a plain Int, since
  /// LookupValue is a Cpanel table and the cross-domain rule forbids the key.
  /// The service checks each id against the lookup its `kind` names.
  componentId Int
  amount      Decimal             @db.Decimal(18, 2)
  sortOrder   Int                 @default(0)

  package EmployeeSalaryPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  /// The same allowance twice in one package is a typo, not a second payment.
  @@unique([packageId, kind, componentId])
  @@index([packageId])
  @@map("employee_salary_components")
}

/// Where one employee worked, and as what, between two dates.
///
/// The same shape as a salary package and for the same reason: a promotion or a
/// transfer is a NEW posting starting the day it takes effect, not an edit of
/// the last one. What somebody was on in March stays readable next year, which
/// is what a service record is for.
///
/// A promotion and a transfer are not stored as different KINDS. They are read
/// off the change: a posting whose designation differs from the one before it is
/// a promotion, one whose place differs is a transfer, and a row can be both.
/// Asking somebody to classify it as well as enter it invites the two to
/// disagree.
///
/// Cross-domain rule again: company, branch, division and department are plain
/// `Int` ids with NO @relation (they are Cpanel's), while the designation IS a
/// real relation — it lives in this file.
model EmployeePosting {
  id         Int @id @default(autoincrement())
  employeeId Int

  /// The day this posting starts. Required — a posting with no start cannot be
  /// placed in the history, which is the only thing postings are for.
  effectiveFrom DateTime
  /// The last day of it. NULL = still there, which the newest posting usually
  /// is; a transfer closes the one before it the day before the new one starts.
  effectiveTo   DateTime?

  companyId     Int
  /// Only where the company is branch-applicable — the Company master decides
  /// whether branches exist at all, and the service checks the flag rather than
  /// trusting the form.
  branchId      Int?
  /// Division = CostCenter, department = the CostObject under it. Each only
  /// where the company has that level switched on, same as branch.
  costCenterId  Int?
  costObjectId  Int?
  designationId Int

  /// Why — "promoted to Supervisor", "transferred to Kadathy on request". The
  /// change itself is derived; this is the part only a person knows.
  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  designation HrDesignation @relation(fields: [designationId], references: [id], onDelete: Restrict)

  /// Two postings starting the same day would leave the history with a fork.
  /// The service checks the whole period for overlap; this catches the exact
  /// collision at the database.
  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
  @@index([designationId])
  @@map("employee_postings")
}

// ---------------------------------------------------------------------------
// Attendance (SRS §8.9, FR-HRP-02) — what everybody did, day by day.
//
// Marked by the branch incharge rather than by the staff: most of them have no
// login, and the ones who do are not the ones who answer for the shift. The
// sheet for a day is a DOCUMENT — marked, then verified, then approved through
// the ordinary workflow engine — because attendance is what payroll pays on,
// and one person's unchecked keystroke should not be able to move somebody's
// wage.
//
// FR-HRP-03 keeps the door open for punching machines and biometric devices.
// Nothing here assumes a person typed it: an entry records a time in, a time
// out and a type, which is exactly what a device reports. The day a device is
// connected it writes these same rows and the incharge reviews them instead of
// entering them.
// ---------------------------------------------------------------------------

/// The working day a branch keeps, and what a fresh sheet is filled in with.
///
/// One row per company, plus one per branch that differs — the branch row wins
/// where it exists, and where it does not the company's own row is the answer.
/// Two levels rather than a setting per employee: a bakery has a shift, not two
/// hundred of them. The ones who genuinely differ carry an override on their own
/// record (Employee.defaultTimeIn / defaultTimeOut).
model AttendanceSetting {
  id        Int  @id @default(autoincrement())
  companyId Int
  /// NULL = the company's own default, used by every branch without one.
  branchId  Int?

  /// Minutes after local midnight (09:00 → 540), the same units and for the
  /// same reason as a checklist's start time: this is a time of DAY, and the
  /// server runs in UTC.
  defaultTimeIn  Int @default(540)
  defaultTimeOut Int @default(1080)
  /// What a fresh line says before anybody touches it — an ATTENDANCE_TYPE
  /// LookupValue, normally Present. A plain Int: LookupValue is Cpanel's.
  defaultTypeId  Int?

  /// The days of the week this branch does not work, 0 = Sunday … 6 = Saturday.
  /// Those days come up pre-filled as the weekly off rather than as absence —
  /// the difference between "not due at work" and "did not turn up".
  weeklyOffDays Int[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per branch, and one for the company itself. Postgres counts NULLs
  /// as distinct, so the company-level row is guarded in the service as well.
  @@unique([companyId, branchId])
  @@map("attendance_settings")
}

/// A dated day off — the public and company holidays, kept per year.
///
/// Beside the weekly off rather than folded into it: one is a rule about the
/// week, the other a list of dates that changes every year and is set months
/// ahead. A sheet for a holiday comes up pre-filled as one.
model AttendanceHoliday {
  id        Int    @id @default(autoincrement())
  companyId Int
  /// NULL = the whole company. A branch may keep a local holiday of its own.
  branchId  Int?
  date      DateTime
  name      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, branchId, date])
  @@index([companyId, date])
  @@map("attendance_holidays")
}

/// Where a day's sheet has got to.
///
/// DRAFT is being marked; SUBMITTED is anywhere inside the workflow, whatever
/// the configured step is called ("Verified" and "Approved" are labels the
/// business sets in Cpanel → Workflows, not states in code); APPROVED is
/// signed off and closed to further marking.
enum AttendanceSheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

/// One branch's attendance for one day — the thing that is marked, verified
/// and approved.
///
/// The document is the DAY, not the month: a shift is answered for while the
/// people who worked it are still on the premises, and a month-old dispute is
/// nobody's memory. The month is assembled by the register report, which reads
/// the days back.
model AttendanceSheet {
  id        Int  @id @default(autoincrement())
  companyId Int
  /// NULL where the company keeps no branches. A branch marks its own people.
  branchId  Int?
  /// The day itself, held as a date-only marker (midnight UTC).
  date      DateTime

  status AttendanceSheetStatus @default(DRAFT)

  /// The engine's instance, and the label of the step it has reached — the
  /// same pair every other document in the workflow carries.
  workflowInstanceId Int?
  workflowStatus     String?

  /// Who marked it and when. The verifier and approver are not repeated here:
  /// the workflow's own trail already says who did what, and a second copy is a
  /// second thing to keep in step.
  markedByUserId Int?
  markedAt       DateTime?

  /// About the day as a whole — a power cut, a strike, a festival rush.
  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries AttendanceEntry[]

  /// One sheet per branch per day. The database says so as well as the service,
  /// because two sheets for one day is two answers for payroll.
  @@unique([companyId, branchId, date])
  @@index([companyId, date])
  @@map("attendance_sheets")
}

/// One person's line on one day's sheet.
model AttendanceEntry {
  id         Int @id @default(autoincrement())
  sheetId    Int
  employeeId Int

  /// An ATTENDANCE_TYPE LookupValue — Present, Absent, Half Day, the leaves,
  /// the weekly off. A list rather than an enum because which kinds of day a
  /// business recognises is the business's to keep, and because the register
  /// pivots whatever they have defined into a column each.
  typeId Int

  /// Minutes after local midnight, as in AttendanceSetting. Null on the days
  /// where the question does not arise — an absence has no time in.
  timeIn  Int?
  timeOut Int?
  /// What in and out come to, worked out on save so a report never has to
  /// re-derive it and two readers can never disagree. A time out BEFORE the
  /// time in is read as a shift that crossed midnight, which is an ordinary
  /// night in a bakery.
  workedMinutes Int?

  /// True where anything on this line differs from what the day was filled in
  /// with — a different time, a different type. The whole point of defaults is
  /// that only the exceptions are touched, so the exceptions are worth
  /// knowing: this is what the sheet highlights and what a verifier reads
  /// first. Recorded as at marking, so a later change to the settings does not
  /// silently rewrite the past.
  isException Boolean @default(false)

  /// Why it differs — "left early, dentist", "covered the night shift".
  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sheet    AttendanceSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([sheetId, employeeId])
  @@index([employeeId])
  @@map("attendance_entries")
}

// ---------------------------------------------------------------------------
// Shifts and the roster (SRS §8.9, FR-HRP-01: "shifts and rosters per branch").
// ---------------------------------------------------------------------------

/// A named working pattern — Morning 06:00–14:00, Night 22:00–06:00.
///
/// Per company, and optionally down to ONE BRANCH: a shift only the bakery
/// works has no business appearing on the office's roster. A shift with no
/// branch is the company's, offered everywhere.
///
/// Distinct from AttendanceSetting, which is what a branch works BY DEFAULT.
/// This is a pattern somebody can be put ON, for the days a rota says so.
model HrShift {
  id        Int @id @default(autoincrement())
  companyId Int

  /// True = every branch in the company, and the links below are empty.
  ///
  /// The same shape the other masters use for their company links: a flag for
  /// "all of them" beside a set of rows for "these ones". A shift kept by three
  /// branches out of five is the ordinary case, and one column could only ever
  /// say one branch or all of them.
  allBranches Boolean @default(true)

  /// The short form, typed rather than generated: it is what fills a cell on a
  /// roster and what people call the shift out loud — "he's on N this week".
  code String
  name String

  /// Minutes after local midnight, as everywhere else a time of day is stored.
  /// A finish at or before the start is a shift that crosses midnight, which is
  /// what a night shift is.
  timeIn  Int
  timeOut Int
  /// Unpaid break inside the shift, in minutes. Taken off the hours a rostered
  /// day is worth.
  breakMinutes Int @default(0)

  remarks String?

  isActive  Boolean  @default(true)
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments EmployeeShiftAssignment[]
  branches    HrShiftBranch[]

  /// One code per company. Two shifts called "N" is a roster nobody can read.
  @@unique([companyId, code])
  @@index([companyId])
  @@map("hr_shifts")
}

/// Links a shift to a branch that works it (when not `allBranches`).
///
/// branchId is a plain id -> Cpanel Branch, with no cross-domain FK, as
/// everywhere else in this file.
model HrShiftBranch {
  id       Int @id @default(autoincrement())
  shiftId  Int
  branchId Int

  shift HrShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([shiftId, branchId])
  @@index([branchId])
  @@map("hr_shift_branches")
}

/// Who is on which shift, from when — the roster.
///
/// A dated SERIES, exactly like a posting or a salary package: putting somebody
/// on nights is a new row starting the day it takes effect, and the one before
/// it closes the day before. That is what lets last March's attendance still
/// resolve against the shift they were actually on in March, rather than the
/// one they are on now.
///
/// The attendance sheet reads this FIRST — before the person's own hours and
/// before the branch's working day — because a roster is the most specific
/// statement anybody has made about that day.
model EmployeeShiftAssignment {
  id         Int @id @default(autoincrement())
  employeeId Int
  shiftId    Int

  /// The day this assignment starts. Required — an assignment with no start
  /// cannot be placed in the series, which is the only thing the series is for.
  effectiveFrom DateTime
  /// The last day of it. NULL = until changed, which the newest row usually is.
  effectiveTo   DateTime?

  /// Why they were moved — "covering nights while Suresh is on leave".
  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    HrShift  @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  /// Two assignments starting the same day would fork the series. The service
  /// checks the whole period for overlap; this catches the exact collision.
  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
  @@index([shiftId])
  @@map("employee_shift_assignments")
}
