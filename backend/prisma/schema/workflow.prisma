// Workflow domain — a configurable document-approval engine.
//
// Admins define, per document type (company + branch + module + form), an ordered
// chain of approval steps (WorkflowStep). At runtime a document travels through a
// WorkflowInstance: each step raises WorkflowTasks (the approver inbox) and every
// action is written to WorkflowActionLog. Steps can route ACROSS company / branch
// / module boundaries via their target* overrides.
//
// The engine no longer keeps a notification table of its own: an approval alert
// is an ordinary Notification (see notification.prisma), raised through the
// NOTIFICATION port and keyed `workflow:task:<id>` so the engine can take it back
// when the task stops being PENDING. A person has one bell, not one per module.
//
// Cross-domain rule: every reference to a Cpanel row (company, branch, module,
// object, user, user group) is a plain `Int` id with NO @relation — real relations
// stay inside this domain file. (Enforced by npm run lint:boundaries.)

/// What the approver at a step may do, and how the document proceeds.
enum WorkflowActionType {
  CREATE_APPROVE // create + self-approve; end of workflow
  CREATE_FORWARD // create + forward to next level for approval
  APPROVE // approve; end of workflow
  APPROVE_FORWARD // approve + forward to next level for further approval
  CREATE_REFERENCE // create + send to next level for reference only (no action there)
  REFERENCE // view only; end of workflow
  REVIEW_FORWARD // no action, forward to next level
  // Approve AND hand the document on to its module's business logic; end of
  // workflow. The engine does NOT do the converting — it can't reach a business
  // module — it reports which action fired and the module acts on it. Only the
  // ICPO answers to this today (CRM turns it into a sales order); on any other
  // document it behaves as a plain APPROVE.
  CONVERT_ICSO // approve + convert an ICPO into an Inter-Company Sales Order
}

/// Whole-form approval, or approval gated by a numeric field's limit.
enum WorkflowApprovalMode {
  FORM
  FIELD
}

enum WorkflowInstanceStatus {
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
}

enum WorkflowTaskStatus {
  PENDING
  DONE
  SKIPPED
}

/// Reusable document-status vocabulary (super-admin managed). A workflow step's
/// `statusLabel` is chosen from these names; the paired icon is what the document
/// listing shows (with the name as a hover tooltip).
model WorkflowStatus {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  icon      String? // lucide icon name (see frontend lib/icons)
  color     String? // hex colour for the icon (e.g. #16a34a)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workflow_statuses")
}

/// A workflow definition (Tab 1) — bound to the document type it governs. When a
/// document of (companyId [+ branchId], moduleId, objectId=FORM) is submitted, the
/// matching active definition drives its approval chain.
model WorkflowDefinition {
  id        Int     @id @default(autoincrement())
  name      String
  companyId Int // origin company
  branchId  Int? // origin branch / profit-center (null = any branch)
  moduleId  Int // -> Module (origin module)
  objectId  Int // -> ObjectMaster (the FORM this workflow is for)
  isActive  Boolean @default(true)
  isLocked  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps WorkflowStep[]

  @@index([companyId, moduleId, objectId])
  @@map("workflow_definitions")
}

/// One level of a workflow (Tab 2), ordered by `sequence` (1..n). The approver is
/// the selected `users` (all get the task) or, if none, everyone in `userGroupId`.
/// target* columns route this level to a different company / branch / module than
/// the definition's origin (null = same as the definition).
model WorkflowStep {
  id           Int @id @default(autoincrement())
  definitionId Int
  sequence     Int // 1 = first level, then in order

  userGroupId     Int? // -> UserGroup (approver group)
  targetCompanyId Int? // -> Company (null = definition.companyId)
  targetBranchId  Int? // -> Branch  (null = definition.branchId)
  targetModuleId  Int? // -> Module  (null = definition.moduleId) — module-to-module routing

  action     WorkflowActionType
  buttonText String // label shown on the action button (e.g. "Approve", "Fwd to Accounts")
  statusLabel String? // document status shown once this step acts (e.g. "Forwarded to CRM")

  approvalMode WorkflowApprovalMode @default(FORM)
  fieldName    String? // field checked when approvalMode = FIELD
  valueFrom    Float? // inclusive lower limit
  valueTo      Float? // inclusive upper limit

  canCancel   Boolean @default(false) // Cancel button visible
  canReject   Boolean @default(false) // Reject button visible
  canEdit     Boolean @default(false) // this approver may edit the record
  notifyInApp Boolean @default(true) // raise an in-app alert on assignment
  slaHours    Int? // optional SLA for future escalation

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  users      WorkflowStepUser[]

  @@index([definitionId])
  @@map("workflow_steps")
}

/// A user explicitly assigned to a step (the document is available to every
/// selected user; the first to act completes the level).
model WorkflowStepUser {
  id     Int @id @default(autoincrement())
  stepId Int
  userId Int // -> User

  step WorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([stepId, userId])
  @@index([userId])
  @@map("workflow_step_users")
}

/// A running approval for one document.
///
/// `amount` is the document's headline value — what a listing shows and what a
/// limit tests unless a step names something else. `fields` is what makes
/// WorkflowStep.fieldName mean anything: the module hands over its numbers BY
/// NAME when it starts the approval, and a step's limit tests the one it names.
/// Without it the engine had a single anonymous number, so a step could say it
/// was limiting "grandTotal" while the engine went on testing the only figure
/// it had.
model WorkflowInstance {
  id           Int  @id @default(autoincrement())
  definitionId Int
  companyId    Int
  branchId     Int?
  moduleId     Int
  objectId     Int

  documentId  Int // the business record id (plain, cross-domain)
  documentRef String? // human-readable snapshot (e.g. a code) for display
  amount      Float? // the headline value: shown in the inbox, and the default a limit tests
  /// The document's numbers by name, as its module supplied them — what a
  /// FIELD-approval step's `fieldName` selects from. Null on instances started
  /// before this existed; those fall back to `amount`.
  fields      Json?

  currentSequence Int                    @default(1)
  status          WorkflowInstanceStatus @default(IN_PROGRESS)
  startedByUserId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks         WorkflowTask[]
  actions       WorkflowActionLog[]
  @@index([moduleId, objectId, documentId])
  @@index([status])
  @@map("workflow_instances")
}

/// An actionable item at the current level for one assignee (the inbox row).
model WorkflowTask {
  id         Int @id @default(autoincrement())
  instanceId Int
  stepId     Int
  sequence   Int

  assignedUserId Int
  // false when approvalMode = FIELD and the instance amount is beyond this step's
  // limit → the approver may only review-and-forward, not approve.
  canApprove     Boolean            @default(true)
  status         WorkflowTaskStatus @default(PENDING)
  actedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([assignedUserId, status])
  @@index([instanceId])
  @@map("workflow_tasks")
}

/// Immutable audit trail — one row per action taken on an instance.
model WorkflowActionLog {
  id         Int     @id @default(autoincrement())
  instanceId Int
  stepId     Int?
  sequence   Int
  userId     Int
  action     String // CREATE / APPROVE / FORWARD / REJECT / CANCEL / REFERENCE
  comment    String?

  createdAt DateTime @default(now())

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@map("workflow_action_logs")
}