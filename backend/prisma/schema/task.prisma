// Task domain — operational task boards and shared checklists (SRS §8.12).
//
// Work one person hands to another: a title, who it is for, when it is due, what
// state it is in, and the checklist that says what "done" means. Part of the
// Workplace module's surface beside mail and chat — the difference being that a
// task is owed rather than said, so it carries a due date and a state and
// somebody is answerable for it.
//
// Cross-domain rule: every reference to a Cpanel row (user, company, branch) is
// a plain `Int` id with NO @relation — real relations stay inside this domain
// file. (Enforced by npm run lint:boundaries.)

/// Where a task has got to. These are the board's columns, in this order —
/// CANCELLED has none: a task called off is out of the way, not parked in a
/// lane people have to look past every morning.
enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

/// How urgent it is. NORMAL is the default because a board where everything is
/// High says nothing about anything.
enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// One piece of work.
///
/// Scoped to company and branch (FR-TSK-01): the board a branch works from is
/// the branch's, and a task raised for the factory has no business showing on
/// the counter's list. `branchId` null means company-wide — those show on every
/// branch's board, because that is what "for the company" means.
model Task {
  id          Int     @id @default(autoincrement())
  title       String
  description String?

  companyId Int
  branchId  Int? // null = company-wide

  createdById Int

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(NORMAL)

  /// When it is due. Null is allowed on purpose — plenty of real work is "when
  /// you can", and forcing a date on it would only produce fictional ones.
  dueAt DateTime?

  completedAt   DateTime?
  completedById Int?

  /// Position within its board column, so a board can be ordered by hand.
  /// Ties break on id, which keeps the order stable rather than arbitrary.
  sortOrder Int @default(0)

  /// The recurring checklist this task was generated from, if it was not raised
  /// by a person (FR-TSK-02). Null on every hand-raised task.
  templateId   Int?
  /// WHICH occurrence it is — the local calendar date the run belongs to, held
  /// at midnight UTC as a date-only marker.
  ///
  /// This is what makes generation idempotent. The scheduler runs every few
  /// minutes and has no memory; the unique constraint below is what stops a
  /// second pass, a restart, or two replicas from raising Monday's opening
  /// checks twice. Deliberately NOT `createdAt`-based: a run that generated late
  /// still belongs to the day it was for.
  occurrenceOn DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignees TaskAssignee[]
  checklist TaskChecklistItem[]
  comments  TaskComment[]
  template  ChecklistTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)

  /// One task per template per occurrence. See occurrenceOn.
  @@unique([templateId, occurrenceOn])
  @@index([companyId, status])
  @@index([createdById])
  @@map("tasks")
}

/// How often a recurring checklist comes round.
///
/// Three, and no cron expression. What a bakery actually runs is "every day
/// before opening", "every Monday", "the first of the month" — and a field that
/// accepts `0 6 * * 1-5` is one a supervisor cannot fill in or check.
enum ChecklistFrequency {
  DAILY
  /// On the chosen weekdays. One or more; Sunday is 0.
  WEEKLY
  /// On the chosen day of the month, clamped to the last day of short ones.
  MONTHLY
}

/// A checklist that raises itself, on a schedule (SRS §8.12, FR-TSK-02:
/// "recurring checklists (opening/closing, hygiene, production)").
///
/// It is a TEMPLATE, not a running list. Each occurrence becomes an ordinary
/// Task with ordinary checklist items, and that is the whole design: a generated
/// checklist lands on the same board, is ticked by the same people, records who
/// ticked what and when (§8.13 hygiene), takes comments, and raises the same
/// assignment and overdue alerts. A parallel "checklist run" model would have
/// needed every one of those built a second time, and would have left a branch
/// with two places to look for what it has to do this morning.
///
/// Scoped to company and branch like the board it feeds (FR-TSK-01): the
/// opening checks at Kadathy are Kadathy's, and `branchId` null means the
/// company as a whole.
model ChecklistTemplate {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  companyId Int
  branchId  Int? // null = company-wide

  /// Who set it up. They own what it says, exactly as a task's raiser does.
  createdById Int

  frequency  ChecklistFrequency @default(DAILY)
  /// WEEKLY: which days, 0 = Sunday. Ignored by the other frequencies.
  weekdays   Int[]              @default([])
  /// MONTHLY: which day, 1-31. Clamped to the last day of a shorter month, so a
  /// 31st checklist still happens in February rather than skipping it.
  dayOfMonth Int?

  /// The first day it may run, and the last — the checklist's own working life.
  ///
  /// A seasonal round, a checklist that covers a refit, one that runs until an
  /// audit: all of them have dates, and without them the only way to stop one is
  /// to remember to go and pause it. `endsOn` null means it runs until somebody
  /// says otherwise, which is the common case and so the default.
  ///
  /// Date-only markers (midnight UTC), like Task.occurrenceOn — these are
  /// calendar dates, not instants. `startsOn` also bounds the register: nothing
  /// before it was ever expected, so nothing before it can have been missed.
  startsOn DateTime
  endsOn   DateTime?

  /// When it appears, as minutes after local midnight (06:00 → 360).
  ///
  /// Minutes rather than a DateTime because this is a time of DAY, not an
  /// instant — and local, because a 6 a.m. opening check is 6 a.m. where the
  /// bakery is. The zone is the application's (APP_TIMEZONE, see
  /// common/zoned-time.ts); the server runs in UTC and must not be allowed to
  /// turn 06:00 into 11:30.
  startMinutes Int  @default(360)
  /// When it must be finished by, same units. Null = the end of that local day.
  dueMinutes   Int?

  priority TaskPriority @default(NORMAL)

  /// Off means it stops generating. Kept rather than deleted, so the tasks it
  /// has already raised keep the record of where they came from.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     ChecklistTemplateItem[]
  assignees ChecklistTemplateAssignee[]
  /// Everything it has raised. SetNull on delete: the tasks survive their
  /// template, because a completed hygiene check is a record and deleting the
  /// schedule must not delete the evidence.
  tasks     Task[]

  @@index([companyId, isActive])
  @@index([createdById])
  @@map("checklist_templates")
}

/// One line of the checklist, as it will be copied onto every occurrence.
///
/// Copied, not referenced: the tasks a branch completed last month must keep the
/// wording they were completed against. Editing a template changes what happens
/// tomorrow, never what was signed for yesterday.
model ChecklistTemplateItem {
  id         Int               @id @default(autoincrement())
  templateId Int
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  text      String
  sortOrder Int    @default(0)

  @@index([templateId])
  @@map("checklist_template_items")
}

/// Who each occurrence is raised for.
model ChecklistTemplateAssignee {
  id         Int               @id @default(autoincrement())
  templateId Int
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId     Int

  @@unique([templateId, userId])
  @@index([templateId])
  @@map("checklist_template_assignees")
}

/// Who a task is for. Several people can share one (SRS: "multi-user
/// collaborative assignments"), and the task carries ONE state between them —
/// splitting the state per person would turn one job into several that can
/// disagree about whether it is finished.
model TaskAssignee {
  id     Int  @id @default(autoincrement())
  taskId Int
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId Int

  createdAt DateTime @default(now())

  @@unique([taskId, userId])
  // "My tasks" is this index.
  @@index([userId])
  @@map("task_assignees")
}

/// One line of a task's checklist — what has to be true for it to be done
/// (SRS §8.12: opening/closing, hygiene and production checklists; §8.13 hangs
/// the mess hygiene checks off the same thing).
model TaskChecklistItem {
  id     Int  @id @default(autoincrement())
  taskId Int
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  text      String
  sortOrder Int       @default(0)
  isDone    Boolean   @default(false)
  /// Who ticked it, and when. Kept because a hygiene check nobody can be named
  /// for is not a record of anything.
  doneById  Int?
  doneAt    DateTime?

  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_checklist_items")
}

/// A note on a task — the back-and-forth that would otherwise happen in chat,
/// where it would be lost to the task it was about.
model TaskComment {
  id     Int  @id @default(autoincrement())
  taskId Int
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId Int
  body   String

  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_comments")
}
