// CRM domain — the intercompany order flow, both sides of it.
//
// A requester (a branch of e.g. EK Bake House) raises an ICPO on a SUPPLIER
// company (EK Food Products / Regency Bakers). The order is OWNED by the
// supplier (PurchaseOrder.companyId) and reviewed by that company's CRM staff
// via the workflow engine — they see it as "ICPO - Received". Once approved they
// CONVERT it into a SalesOrder (below), checking quantities on the way.
//
// Per the schema-ownership rule, every cross-domain reference (company, branch,
// user, product, unit, workflow) is a plain Int id with NO @relation — including
// SalesOrder.purchaseOrderId, which points at a row in this same file but is
// kept plain for consistency with the rest of the domain.

/// Lifecycle of a Purchase Order - IC.
enum PurchaseOrderStatus {
  DRAFT // created by the requester, not yet submitted into the approval workflow
  PLACED // submitted; travelling through the approval workflow
  APPROVED // accepted by the supplier's CRM staff (workflow complete)
  REJECTED
  CANCELLED
}

model PurchaseOrder {
  id                 Int                 @id @default(autoincrement())
  companyId          Int // supplier company that receives this order
  // Numbered by the company+branch that RAISED it (orderingCompanyId /
  // orderingBranchId below), not by the supplier: a document belongs to whoever
  // initiates it, and it is the buyer who writes an ICPO.
  orderNo            String // per-buyer-branch sequential number (PO-#####)
  orderDate          DateTime            @default(now())
  deliveryAt         DateTime? // requested delivery date & time (carried to the sales order)
  // Requester (who raised it) — an intercompany branch today.
  orderingCompanyId  Int // -> Company (e.g. EK Bake House)
  orderingBranchId   Int? // -> Branch of the requester
  placedByUserId     Int // -> User (the branch manager)
  status             PurchaseOrderStatus @default(DRAFT)
  workflowStatus     String? // human-readable status from the workflow step that last acted
  notes              String?
  workflowInstanceId Int? // -> WorkflowInstance (approval routing)
  isLocked           Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  lines PurchaseOrderLine[]

  // Unique per BUYER, matching who the series belongs to. Were it per supplier,
  // two buyers drawing on their own sequences would both offer PO-00001 to the
  // same supplier and one would be rejected for a clash it did not cause.
  @@unique([orderingCompanyId, orderNo])
  @@index([companyId, status])
  @@index([orderingCompanyId])
  @@map("purchase_orders")
}

/// One line of a Purchase Order - IC: `quantity` of a `product` (in `unit`), at
/// the group's transfer price.
model PurchaseOrderLine {
  id        Int   @id @default(autoincrement())
  orderId   Int
  sequence  Int   @default(0)
  productId Int // -> inventory Product (plain cross-domain id)
  // What the BUYER asked for. Never touched by the supplier — the demand must
  // stay legible next to what was actually committed.
  quantity  Float
  unitId    Int // -> Unit (plain cross-domain id)
  // The supplier's answer, set by Customer Relations while the order is in their
  // hands. null = not reviewed yet (distinct from a deliberate 0). May EXCEED
  // what's in stock: reserve takes what exists and the rest is produced, which is
  // the whole reason a manufacturer accepts an order it can't ship today.
  acceptedQty Float?
  // A line the supplier refuses. Kept on the order rather than deleted so the
  // buyer can see their line was declined instead of watching it vanish;
  // acceptedQty is forced to 0 and any reservation released.
  cancelled Boolean @default(false)

  // NO RATE, deliberately. An intercompany order carries quantities only; the
  // price is decided later, by the BATCH that ends up shipping (see
  // SalesOrderLine.rate). Stock physically labelled at an old price cannot be
  // sold at a new one, so a price fixed here — before anyone knows which batch
  // fills the order — would be a guess that the goods then contradict.
  // Product.intercompanyPrice is only the latest price, for information.
  // Consequence: an ICPO has no value, so its approval steps must be
  // whole-form; a field-limit step has nothing to test and would pass anything.

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("purchase_order_lines")
}

// ---------------------------------------------------------------------------
// Sales Orders — the selling side.
// ---------------------------------------------------------------------------

/// Lifecycle of a Sales Order. Mirrors PurchaseOrderStatus: the seller's own CRM
/// staff raise it and it travels their approval chain.
enum SalesOrderStatus {
  DRAFT // converted / created, not yet submitted into the approval workflow
  PLACED // submitted; travelling through the approval workflow
  APPROVED // approval workflow complete — the order stands
  REJECTED
  CANCELLED
}

/// An order to SUPPLY goods, owned by the selling company.
///
/// Two flavours share this model, told apart by which counterparty is set:
///  - ICSO (inter-company): `buyerCompanyId` — converted from an approved ICPO,
///    which `purchaseOrderId` points back at.
///  - LSO (local/external): `customerId` — raised on an external customer. NOT
///    BUILT YET; the Customer master doesn't exist. It joins this model rather
///    than getting its own, because unlike ICPO vs LPO nothing inverts here:
///    `companyId` is the SELLER either way, so the unique constraint, the
///    numbering key and the company scoping all keep working. Adding it is one
///    nullable column plus an XOR guard.
model SalesOrder {
  id        Int @id @default(autoincrement())
  companyId Int // the SELLER — owns the order, its numbering and its visibility
  branchId  Int? // -> Branch OF THE SELLER (the one that took the order). Distinct
  //                 from buyerBranchId below, which belongs to the other company.
  //                 This is the branch the order NUMBER is drawn against.

  // Counterparty — exactly one, enforced in SalesOrderService (Prisma has no XOR).
  buyerCompanyId Int? // -> Company (the group company that raised the ICPO)
  buyerBranchId  Int? // -> Branch of that company
  // customerId  Int?  <- added with the Customer master, for the LSO

  // The ICPO this was converted from. Unique: an ICPO converts once.
  purchaseOrderId Int?      @unique
  // The origin PO as it stood AT CONVERSION. Snapshotted, not joined: the sales
  // order is the seller's own record of what was asked for, and must keep saying
  // so even if the ICPO is later edited by an approver whose step allows it.
  poNumber        String?
  poDate          DateTime?
  poDeliveryAt    DateTime? // delivery date & time the buyer asked for
  poNotes         String? // the buyer's instructions

  orderNo         String // per-seller sequential number (SO-#####)
  orderDate       DateTime  @default(now())
  deliveryAt      DateTime? // what the seller commits to (seeded from poDeliveryAt)
  createdByUserId Int // -> User (the CRM staffer who converted / raised it)

  status             SalesOrderStatus @default(DRAFT)
  workflowStatus     String? // human-readable status from the step that last acted
  notes              String?
  workflowInstanceId Int? // -> WorkflowInstance (approval routing)
  isLocked           Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  lines SalesOrderLine[]

  @@unique([companyId, orderNo])
  @@index([companyId, status])
  @@index([buyerCompanyId])
  @@map("sales_orders")
}

/// One line of a Sales Order: what we will actually supply, against what was asked.
model SalesOrderLine {
  id         Int   @id @default(autoincrement())
  orderId    Int
  sequence   Int   @default(0)
  productId  Int // -> inventory Product (plain cross-domain id)
  // The batch this line ships from, its number snapshotted for the document.
  // NULL = nothing reserved: this quantity must be PRODUCED, so no batch exists
  // to take a price from yet.
  batchId    Int? // -> inventory StockBatch (plain cross-domain id)
  batchNo    String?
  // What the ICPO asked for, of this PRODUCT. Repeated across the product's split
  // lines — it describes the demand, not the line, so sum `quantity` (never this)
  // for the order's totals. 0 on a directly-raised order.
  orderedQty Float @default(0)
  // What THIS line supplies. A line set to 0 is dropped from the order entirely
  // rather than stored as a zero.
  quantity   Float
  unitId     Int // -> Unit (plain cross-domain id)
  // Selling price per unit.
  //  - Batch-backed line: the batch's own intercompany price, captured when that
  //    stock came in. NOT editable — the goods carry that price, and stock
  //    labelled at an old price cannot be sold at a new one.
  //  - Balance line (batchId null): defaulted from Product.intercompanyPrice —
  //    the latest price, which is information only — and EDITABLE, because the
  //    batch that will carry the real price does not exist until it is produced.
  rate       Float @default(0)

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("sales_order_lines")
}

/// Lifecycle of a Dispatch (goods shipped against a sales order).
enum DispatchStatus {
  DISPATCHED // shipped from the seller; documents generated
  RECEIVED // the buyer confirmed receipt (intercompany only)
  CANCELLED
}

/// A Dispatch — the seller ships goods against an approved sales order (ICSO).
/// Stock goes OUT of the source store and the documents that travel with the
/// goods (tax invoice, delivery note, e-way bill) are generated. For an
/// intercompany buyer the goods are later received (GRN + stock-in) on the buyer
/// side; for an external customer it is stock-out only. Cross-domain ids plain.
model Dispatch {
  id              Int            @id @default(autoincrement())
  companyId       Int // the SELLER (owns the sales order)
  branchId        Int?
  dispatchNo      String // DSP-#### per company
  salesOrderId    Int            @unique // the ICSO dispatched (one dispatch per order)
  soNumber        String? // snapshot
  buyerCompanyId  Int? // internal EK Group buyer; null = external customer
  buyerBranchId   Int?
  storeId         Int? // source store shipped from
  storeName       String? // snapshot
  // Documents that accompany the goods (driver carries them).
  invoiceNo       String?
  deliveryNoteNo  String?
  ewayBillNo      String?
  driverName      String?
  vehicleNo       String?
  dispatchDate    DateTime       @default(now())
  subtotal        Float          @default(0) // sum(qty x rate); GST wired later
  status          DispatchStatus @default(DISPATCHED)
  notes           String?
  isLocked        Boolean        @default(false)
  createdByUserId Int
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  lines DispatchLine[]

  @@unique([companyId, dispatchNo])
  @@index([companyId, status])
  @@map("dispatches")
}

/// One shipped line of a Dispatch.
model DispatchLine {
  id          Int     @id @default(autoincrement())
  dispatchId  Int
  productId   Int // -> inventory Product (plain id)
  productName String // snapshot
  quantity    Float
  unitId      Int // -> Unit (plain id)
  rate        Float   @default(0)
  amount      Float   @default(0) // quantity x rate
  batchId     Int? // -> inventory StockBatch (the batch that ships, if known)
  batchNo     String? // snapshot

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@index([dispatchId])
  @@map("dispatch_lines")
}
