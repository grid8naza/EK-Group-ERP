// CRM domain — inter-company Purchase Orders (Purchase Order - IC).
//
// A requester (an intercompany branch, e.g. a branch of EK Bake House) raises a
// Purchase Order - IC on a SUPPLIER company (EK Food Products / Regency Bakers).
// The order is OWNED by the supplier (companyId) and reviewed by that company's
// CRM staff via the workflow engine, who later convert it into a Sales Order (a
// separate document, added in a later phase). Per the schema-ownership rule,
// every cross-domain reference (company, branch, user, product, unit, workflow)
// is a plain Int id with NO @relation.

/// Lifecycle of a Purchase Order - IC.
enum PurchaseOrderStatus {
  DRAFT // created by the requester, not yet submitted into the approval workflow
  PLACED // submitted; travelling through the approval workflow
  APPROVED // accepted by the supplier's CRM staff (workflow complete)
  REJECTED
  CANCELLED
}

model PurchaseOrder {
  id                 Int                 @id @default(autoincrement())
  companyId          Int // supplier company that owns / receives this order
  orderNo            String // per-supplier sequential number (PO-#####)
  orderDate          DateTime            @default(now())
  deliveryAt         DateTime? // requested delivery date & time (carried to the sales order)
  // Requester (who raised it) — an intercompany branch today.
  orderingCompanyId  Int // -> Company (e.g. EK Bake House)
  orderingBranchId   Int? // -> Branch of the requester
  placedByUserId     Int // -> User (the branch manager)
  status             PurchaseOrderStatus @default(DRAFT)
  notes              String?
  workflowInstanceId Int? // -> WorkflowInstance (approval routing)
  isLocked           Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  lines PurchaseOrderLine[]

  @@unique([companyId, orderNo])
  @@index([companyId, status])
  @@index([orderingCompanyId])
  @@map("purchase_orders")
}

/// One line of a Purchase Order - IC: `quantity` of a `product` (in `unit`).
model PurchaseOrderLine {
  id        Int   @id @default(autoincrement())
  orderId   Int
  sequence  Int   @default(0)
  productId Int // -> inventory Product (plain cross-domain id)
  quantity  Float
  unitId    Int // -> Unit (plain cross-domain id)

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("purchase_order_lines")
}
